@page "/"

<PageTitle>Ant Design X Blazor</PageTitle>

<section class="VPHero has-image">
    <div class="container">
        <div class="main">
            <h1 class="name">
                Ant Des<span class="hero-brand-i">I<span></span></span>gn X
            </h1>
            <p class="text">AI 体验新秩序</p>
            <p class="tagline">Ant Design X For Blazor。基于 RICH 设计范式，打造卓越 AI 界面解决方案，引领智能新体验。</p>

            <div class="actions">
                <div class="action">
                    <a class="VPButton brand" href="component/overview">开始使用</a>
                </div>
                <div class="action">
                    <a class="VPButton alt" href="development/introduce">关于项目</a>
                </div>
            </div>
        </div>

        <div class="image">
            <div class="image-container">
                <div class="image-bg"></div>
                <DocsHeroVisual />
            </div>
        </div>
    </div>
</section>

<section class="VPHomeSection home-rich-intro">
    <div class="home-container">
        <h2>AI 设计范式 - RICH</h2>
        <p>我们致力于构建 AI 设计理论，并在 Blazor 产品实践中持续迭代。在此过程中，RICH 设计范式应运而生：角色（Role）、意图（Intention）、会话（Conversation）和混合界面（Hybrid UI）。</p>

        <div class="home-rich-map" aria-hidden="true">
            <div class="home-rich-orbit orbit-one"></div>
            <div class="home-rich-orbit orbit-two"></div>
            <div class="home-rich-core">
                <img src="assets/mdn/a-eco6RrQhxbMAAAAAAAAAAAAADgCCAQ.svg" alt="" />
                <span>RICH</span>
            </div>
            @foreach (var item in RichNodes)
            {
                <div class="home-rich-node @item.Class">
                    <strong>@item.Code</strong>
                    <span>@item.Text</span>
                </div>
            }
        </div>
    </div>
</section>

<section class="VPHomeSection home-solution-section">
    <div class="home-container">
        <h2>AI 界面解决方案</h2>
        <p>基于 RICH，延续熟悉的 Ant Design 设计语言，全新 AGI 混合界面（Hybrid-UI）解决方案，完美融合 GUI 和自然会话交互。从唤醒到表达，从过程到反馈，合适的组件恰当的呈现在所有的人机互动过程中。</p>

        <div class="home-solution-track">
            @foreach (var item in SolutionItems)
            {
                <article class="home-solution-card">
                    <div class="solution-visual">
                        <img src="@item.Icon" alt="" loading="lazy" />
                        <img src="@item.Icon" alt="" loading="lazy" aria-hidden="true" />
                        <span style="@item.LineStyle"></span>
                    </div>
                    <div class="solution-copy">
                        <div class="solution-index"><span>@item.Index.</span>@item.Name</div>
                        <h3>
                            <span>@item.Prefix</span>
                            <span style="@item.GradientStyle">@item.Highlight</span>
                            <span>@item.Suffix</span>
                        </h3>
                        <p>@item.Description</p>
                        <a class="home-text-button" href="@item.Href">从@item.Name开始</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="VPHomeSection home-playground-section">
    <div class="home-container home-playground-container">
        <h2>试一试 , 多种 AI 场景体验</h2>
        <p>提供多场景解决方案 , 帮助用户提高与 AI 协作效率</p>
        <img class="home-playground-bg" src="assets/mdn/a-aSLTSr53DPAAAAAAAAAAAAAADsR-AQ.svg" alt="" loading="lazy" />

        <div class="home-playground-shell">
            <div class="home-scenario-tabs">
                @foreach (var item in ScenarioTabs)
                {
                    <button type="button" class="home-scenario-tab @(item.Disabled ? "is-disabled" : item.Active ? "is-active" : null)" disabled="@item.Disabled">
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                    </button>
                }
            </div>

            <div class="home-scenario-preview">
                <div class="home-scenario-device">
                    <div class="home-scenario-chat">
                        <XBubbleList Items="@ScenarioMessages" RoleConfigs="@ScenarioRoles" AutoScroll="false" Class="home-scenario-bubbles" />
                    </div>

                    <XSender Placeholder="Ant Design X 全新升级了什么?"
                             Value=""
                             Rows="1"
                             SubmitWhenEmpty="true"
                             AttachmentsEnabled="false"
                             Clearable="false"
                             FooterVisible="false"
                             SuffixTemplate="@ScenarioSendTemplate"
                             Class="home-scenario-sender" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="VPHomeSection home-components-section">
    <div class="home-container">
        <h2>组件丰富 , 选用自如</h2>
        <p>Ant Design X Blazor 全新 AI 组件 , 大量实用组件满足你的需求 , 灵活定制与拓展</p>

        <div class="home-card-grid">
            @foreach (var item in ComponentCards)
            {
                <article class="home-feature-card">
                    <div class="home-feature-visual">
                        @item.Visual
                    </div>
                    <div class="home-feature-copy">
                        <h3>@item.Title<span style="@item.GradientStyle">@item.Tag</span></h3>
                        <p>@item.Description</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="VPHomeSection home-ecosystem-section">
    <div class="home-container">
        <h2>AI 设计语言与研发框架</h2>
        <p>配套生态 , 让你快速搭建网站应用</p>

        <div class="home-card-grid home-ecosystem-grid">
            @foreach (var item in EcosystemCards)
            {
                <a class="home-feature-card home-ecosystem-card" href="@item.Href" target="@item.Target" rel="@item.Rel">
                    <div class="home-feature-visual">
                        <img src="@item.Image" alt="" loading="lazy" style="@item.ImageStyle" />
                    </div>
                    <div class="home-feature-copy">
                        <h3>@item.Title</h3>
                        <p>@item.Description</p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

