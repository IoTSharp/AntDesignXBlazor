@page "/"
@implements IDisposable
@inject IXNotificationService NotificationService
@inject XChatStore ChatStore
@inject XAgentStore AgentStore

<PageTitle>首页 · AntDesign.X.Blazor</PageTitle>

<section class="demo-home-hero">
    <div class="demo-hero-copy">
        <div class="demo-kicker">Ant Design X 2.x for Blazor</div>
        <h1>新一代 Blazor AI 界面解决方案</h1>
        <p>参考 Ant Design X 的 RICH 范式与组件组织，把唤醒、表达、确认、反馈四个阶段映射到纯 Blazor + AntDesign.Blazor。这里不是静态首页，而是一套可直接试用的 AI 工作台样板。</p>
        <div class="demo-hero-actions">
            <a class="demo-primary-button" href="components/introduce-cn">
                <Icon Type="rocket" Theme="IconThemeType.Outline" />
                <span>开始使用</span>
            </a>
            <a class="demo-ghost-button" href="components">
                <Icon Type="appstore" Theme="IconThemeType.Outline" />
                <span>查看组件</span>
            </a>
        </div>
        <dl class="demo-hero-metrics" aria-label="能力概览">
            <div>
                <dt>18+</dt>
                <dd>X 语义组件</dd>
            </div>
            <div>
                <dt>4</dt>
                <dd>RICH 阶段</dd>
            </div>
            <div>
                <dt>3</dt>
                <dd>Playground 模式</dd>
            </div>
        </dl>
    </div>
    <div class="demo-hero-stage" aria-label="AI 工作台预览">
        <div class="demo-stage-toolbar">
            <span>Ant Design X Blazor Workspace</span>
            <div class="demo-stage-status">
                <i></i><i></i><i></i>
            </div>
        </div>
        <XWelcome Title="Ant Design X Blazor"
                  Description="从欢迎、提示词、消息流到输入框，首页首屏就呈现真实的 AI 产品界面。"
                  Icon="robot">
            <XPrompts Items="@Prompts.Take(3).ToArray()"
                      Wrap="true"
                      OnItemClick="@UsePrompt" />
        </XWelcome>
        <div class="demo-stage-chat">
            <XBubbleList Items="@Messages.TakeLast(4).ToArray()"
                         RoleConfigs="@BubbleRoleConfigs"
                         Loading="@ChatStore.IsLoading"
                         OnAction="@HandleMessageAction" />
        </div>
        <XSender @bind-Value="@Draft"
                 Attachments="@DraftAttachments"
                 Actions="@SenderActions"
                 Loading="@ChatStore.IsLoading"
                 AutoSize="true"
                 AutoSizeMaxRows="4"
                 ClearAfterSubmit="true"
                 Clearable="true"
                 HeaderVisible="false"
                 SubmitMode="XSenderSubmitMode.Enter"
                 AttachmentsPastable="true"
                 AttachmentsDragHover="true"
                 Placeholder="Ask Ant Design X Blazor anything"
                 BeforeUpload="@BeforeUpload"
                 OnSubmit="@Submit"
                 OnCancel="@Stop"
                 OnClear="@ClearDraft"
                 OnAction="@HandleSenderAction"
                 OnFilesSelected="@AddFiles"
                 OnAttachmentRemove="@RemoveAttachment" />
    </div>
</section>

<section id="rich" class="demo-home-section">
    <header class="demo-section-heading">
        <div class="demo-kicker">AI Design Paradigm</div>
        <h2>围绕 RICH 范式组织页面，而不是堆组件</h2>
        <p>官方站的思路是先解释 AI 界面范式，再把组件放回用户旅程。这个示例站也按“唤醒、表达、确认、反馈”组织首页，让访问者先理解组合方式，再进入组件明细。</p>
    </header>
    <div class="demo-rich-grid">
        <article class="demo-rich-card">
            <Icon Type="bulb" Theme="IconThemeType.Outline" />
            <strong>Awaken 唤醒</strong>
            <p>用 Welcome 与 Prompts 帮用户快速理解 AI 能做什么。</p>
            <a href="components/welcome">Start with Awaken</a>
        </article>
        <article class="demo-rich-card">
            <Icon Type="edit" Theme="IconThemeType.Outline" />
            <strong>Express 表达</strong>
            <p>用 Sender、Attachments、Suggestion 降低输入成本。</p>
            <a href="components/sender">Start with Express</a>
        </article>
        <article class="demo-rich-card">
            <Icon Type="control" Theme="IconThemeType.Outline" />
            <strong>Confirm 确认</strong>
            <p>用 Think 与 ThoughtChain 展示过程，缓解等待焦虑。</p>
            <a href="components/thought-chain">Start with Confirm</a>
        </article>
        <article class="demo-rich-card">
            <Icon Type="check-circle" Theme="IconThemeType.Outline" />
            <strong>Feedback 反馈</strong>
            <p>用 Sources、Actions、Notification 建立结果可信度。</p>
            <a href="components/sources">Start with Feedback</a>
        </article>
    </div>
</section>

<section id="scenarios" class="demo-home-section demo-scenario-section">
    <div class="demo-scenario-copy">
        <div class="demo-kicker">Multiple AI Scenario Experiences</div>
        <h2>从独立对话，到 Copilot，再到嵌入式工作台</h2>
        <p>首页参考官方站的场景叙事，展示多种 AI 产品形态。组件页则保留更细的 demo card，方便开发时复制代码。</p>
        <div class="demo-scenario-links">
            @foreach (var item in DemoShellLinks.PlaygroundLinks)
            {
                <a class="demo-scenario-link" href="@item.Href">
                    <Icon Type="@item.Icon" Theme="IconThemeType.Outline" />
                    <span>@item.Text</span>
                </a>
            }
        </div>
    </div>
    <div class="demo-scenario-preview">
        <div class="demo-scenario-tabs" aria-hidden="true">
            <span class="active">Web - Independent</span>
            <span>Web - Assistant</span>
            <span>Web - Nest</span>
        </div>
        <div class="demo-scenario-window">
            <div class="demo-scenario-sidebar">
                <XConversations Items="@Conversations.Take(3).ToArray()"
                                ActiveKey="@ActiveConversation"
                                ActiveKeyChanged="@SetActiveConversation"
                                Title="Chats" />
            </div>
            <div class="demo-scenario-main">
                <XThoughtChain Title="Agent progress"
                               Items="@Thoughts" />
                <XSources Items="@Sources" />
            </div>
        </div>
    </div>
</section>

<section id="components" class="demo-home-section">
    <header class="demo-section-heading">
        <div class="demo-kicker">Components Rich, Easy to Use</div>
        <h2>组件丰富，但入口要清晰</h2>
        <p>首页只展示组件能力的组合效果；组件页再按官方分类提供“介绍、总览、单项 demo”的文档式路径。</p>
    </header>
    <div class="demo-home-component-grid">
        @foreach (var group in ComponentNav.Groups.Take(6))
        {
            <article class="demo-home-component-card">
                <h3>@group.Title</h3>
                <div>
                    @foreach (var item in group.Items.Take(4))
                    {
                        <a href="@($"components/{item.Slug}")">@item.EnglishTitle</a>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section id="experience" class="demo-home-section demo-workbench-section">
    <header class="demo-section-heading">
        <div class="demo-kicker">Live Workspace</div>
        <h2>完整工作台体验</h2>
        <p>这一块保留真实交互，用来验证 Conversations、BubbleList、Sender、Attachments 和 Prompts 的组合是否顺手。</p>
    </header>
    <div class="demo-chat">
        <XConversations Items="@Conversations"
                        ActiveKey="@ActiveConversation"
                        ActiveKeyChanged="@SetActiveConversation"
                        Title="Conversations"
                        Extra="Blazor"
                        SortTemplate="@ConversationSortTemplate"
                        MenuItems="@ConversationMenuItems"
                        OnMenuAction="@HandleConversationMenuAction"
                        OnDelete="@HandleConversationDelete"
                        OnRename="@HandleConversationRename" />
        <div class="demo-chat-main">
            <XWelcome Title="Ant Design X Blazor"
                      Description="保持 Ant Design X 的对话产品语义，用纯 Blazor 和 AntDesign.Blazor 交付。"
                      Icon="robot">
                <XPrompts Items="@Prompts"
                          Wrap="true"
                          ExpandAllByDefault="true"
                          OnItemClick="@UsePrompt" />
            </XWelcome>
            <div class="demo-chat-scroll">
                <XBubbleList Items="@ChatStore.Messages"
                             RoleConfigs="@BubbleRoleConfigs"
                             Loading="@ChatStore.IsLoading"
                             OnAction="@HandleMessageAction" />
            </div>
            <XSender @bind-Value="@Draft"
                     Attachments="@DraftAttachments"
                     Actions="@SenderActions"
                     Loading="@ChatStore.IsLoading"
                     AutoSize="true"
                     ClearAfterSubmit="true"
                     Clearable="true"
                     HeaderVisible="true"
                     HeaderTemplate="@SenderHeaderTemplate"
                     HeaderCollapsible="true"
                     FooterCollapsible="true"
                     SubmitMode="XSenderSubmitMode.Enter"
                     AttachmentsPastable="true"
                     AttachmentsDragHover="true"
                     BeforeUpload="@BeforeUpload"
                     OnSubmit="@Submit"
                     OnCancel="@Stop"
                     OnClear="@ClearDraft"
                     OnAction="@HandleSenderAction"
                     OnFilesSelected="@AddFiles"
                     OnAttachmentRemove="@RemoveAttachment" />
        </div>
    </div>
</section>

<section id="display" class="demo-home-section">
    <header class="demo-section-heading demo-section-heading-compact">
        <h2>展示组件</h2>
        <p>把思考过程、引用来源和文件结构放在同一个界面语言里。</p>
    </header>
    <div class="demo-grid">
        <XThoughtChain Title="ThoughtChain"
                       Items="@Thoughts" />
        <div>
            <XThink Title="Think"
                    Description="可折叠推理过程"
                    Status="XSemanticStatus.Processing"
                    Content="@ThinkContent" />
        </div>
        <XSources Items="@Sources" />
        <XFolder Title="Folder"
                 Variant="XFolderVariant.Card"
                 Items="@Folders"
                 ActiveKey="@ActiveFolder"
                 ActiveKeyChanged="@SetActiveFolder" />
    </div>
</section>

<section id="input" class="demo-home-section">
    <header class="demo-section-heading demo-section-heading-compact">
        <h2>输入与建议</h2>
        <p>表达阶段重点展示附件、提示集和快捷指令。</p>
    </header>
    <div class="demo-grid">
        <XAttachments Title="Attachments"
                      Items="@DraftAttachments"
                      UploadEnabled="true"
                      DragHover="true"
                      Pastable="true"
                      BeforeUpload="@BeforeUpload"
                      OnFilesSelected="@AddFiles"
                      OnRemove="@RemoveAttachment" />
        <XSuggestion Query="@Draft"
                     Items="@Prompts"
                     OnSelect="@UsePrompt" />
    </div>
</section>

<section id="feedback" class="demo-home-section">
    <header class="demo-section-heading demo-section-heading-compact">
        <h2>反馈与状态</h2>
        <p>结果阶段需要清晰的文件状态、快捷操作和系统通知。</p>
    </header>
    <div class="demo-grid">
        <XFileCard Item="@UploadingFile" />
        <XFileCard Item="@DoneFile" />
        <XActions Items="@MessageActions"
                  OnAction="@HandleMessageAction" />
    </div>
    <XNotification Items="@Notifications"
                   Placement="XNotificationPlacement.TopRight"
                   MaxCount="4"
                   DefaultDuration="@TimeSpan.FromSeconds(4)"
                   OnClose="@CloseNotification" />
</section>

<section id="sdk" class="demo-home-section">
    <header class="demo-section-heading demo-section-heading-compact">
        <h2>SDK 闭环</h2>
        <p>把流式消息、工具调用、来源引用和思考链串起来，模拟真实智能体运行过程。</p>
    </header>
    <div class="demo-grid">
        <div class="demo-agent-panel">
            <div class="demo-sender-header">
                <span>Agent Trace</span>
                <XActions Items="@AgentActions"
                          IconOnly="true"
                          Size="small"
                          OnAction="@HandleAgentAction" />
            </div>
            <XBubbleList Items="@AgentStore.Messages"
                         RoleConfigs="@BubbleRoleConfigs"
                         Loading="@AgentStore.IsRunning"
                         OnAction="@HandleAgentMessageAction" />
            <XActions Items="@AgentStore.ToolActions"
                      OnAction="@HandleAgentToolAction" />
        </div>
        <XThoughtChain Title="ThoughtChain"
                       Items="@AgentStore.Thoughts" />
        <XSources Items="@AgentStore.Sources" />
        <div class="demo-agent-events">
            <div class="demo-agent-events-title">Recent events</div>
            @if (AgentStore.Events.Count == 0)
            {
                <p>Run an agent trace to see thoughts, tool calls, and sources appear here.</p>
            }
            else
            {
                <ul>
                    @foreach (var item in AgentStore.Events.Reverse().Take(6))
                    {
                        <li>
                            <strong>@item.Kind</strong>
                            <span>@item.Title</span>
                            @if (!string.IsNullOrWhiteSpace(item.Content))
                            {
                                <small>@item.Content</small>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

<section id="markdown" class="demo-home-section">
    <header class="demo-section-heading demo-section-heading-compact">
        <h2>Markdown、代码与图</h2>
        <p>面向 AI 输出的内容渲染能力集中放在反馈之后。</p>
    </header>
    <div class="demo-code-grid">
        <XMarkdown Content="@MarkdownSample" />
        <XCodeHighlighter Language="razor"
                          Code="@BubbleCode" />
        <XMermaid Definition="@MermaidDefinition" />
    </div>
</section>

<section id="code" class="demo-home-section">
    <header class="demo-section-heading demo-section-heading-compact">
        <h2>最小使用代码</h2>
        <p>首页只给最短路径，完整 API 和示例进入组件文档页查看。</p>
    </header>
    <XCodeHighlighter Language="razor"
                      Code="@SenderCode" />
</section>

@code {
    private string ActiveConversation { get; set; } = "intro";
    private string ActiveFolder { get; set; } = "components";
    private string? Draft { get; set; }
    private bool ConversationSortDescending { get; set; } = true;

    private readonly List<XAttachmentItem> DraftAttachments = [];
    private readonly List<XNotificationItem> Notifications =
    [
        new() { Key = "hello", Title = "Ready", Description = "Demo application is interactive.", Status = XSemanticStatus.Success, CreatedAt = DateTimeOffset.UtcNow }
    ];
    private readonly List<XConversationItem> ConversationItems =
    [
        new() { Key = "intro", Group = "Today", Title = "Ant Design X Blazor", Description = "组件总览", Icon = "message", Count = 3, UpdatedAt = DateTimeOffset.UtcNow.AddMinutes(-12) },
        new() { Key = "sender", Group = "Today", Title = "Sender patterns", Description = "附件、停止、快捷发送", Icon = "edit", UpdatedAt = DateTimeOffset.UtcNow.AddMinutes(-31) },
        new() { Key = "display", Group = "Earlier", Title = "Display primitives", Description = "来源、思考链、文件卡片", Icon = "appstore", UpdatedAt = DateTimeOffset.UtcNow.AddHours(-5) }
    ];

    private IReadOnlyList<XConversationItem> Conversations =>
        ConversationSortDescending
            ? ConversationItems.OrderByDescending(item => item.UpdatedAt ?? DateTimeOffset.MinValue).ToArray()
            : ConversationItems.OrderBy(item => item.UpdatedAt ?? DateTimeOffset.MinValue).ToArray();

    private IReadOnlyList<XBubbleItem> Messages => ChatStore.Messages;

    private IReadOnlyList<XPromptItem> Prompts =>
    [
        new()
        {
            Key = "build",
            Title = "生成工作台",
            Description = "组合 Conversations + BubbleList + Sender",
            Icon = "thunderbolt",
            Tag = "Chat",
            Children =
            [
                new() { Key = "build-chat", Title = "Chat flow", Description = "消息流和输入编排" },
                new() { Key = "build-files", Title = "File flow", Description = "附件、状态和预览" }
            ]
        },
        new()
        {
            Key = "rag",
            Title = "解释 RAG",
            Description = "展示 Sources、Think 与 ThoughtChain",
            Icon = "experiment",
            Tag = "RAG",
            Children =
            [
                new() { Key = "rag-memory", Title = "Memory", Description = "上下文和引用" },
                new() { Key = "rag-eval", Title = "Evaluation", Description = "查看推理链路" }
            ]
        },
        new()
        {
            Key = "files",
            Title = "处理附件",
            Description = "使用 Attachments 和 FileCard",
            Icon = "paper-clip",
            Tag = "Files",
            Children =
            [
                new() { Key = "files-drop", Title = "Drag & drop", Description = "拖拽时高亮上传区" },
                new() { Key = "files-paste", Title = "Paste file", Description = "从剪贴板接文件" }
            ]
        }
    ];

    private IReadOnlyList<XActionItem> SenderActions =>
    [
        new() { Key = "voice", Label = "Voice", Icon = "audio", Tooltip = "Voice input" },
        new() { Key = "image", Label = "Image", Icon = "picture", Tooltip = "Image generation" }
    ];

    private IReadOnlyList<XActionItem> SenderHeaderActions =>
    [
        new() { Key = "context", Icon = "folder", Tooltip = "Context" },
        new() { Key = "pin", Icon = "pushpin", Tooltip = "Pin draft" }
    ];

    private IReadOnlyList<XActionItem> MessageActions =>
    [
        new() { Key = "copy", Label = "Copy", Icon = "copy" },
        new() { Key = "reload", Label = "Retry", Icon = "reload" },
        new() { Key = "like", Label = "Like", Icon = "like" }
    ];

    private IReadOnlyList<XActionItem> AgentActions =>
    [
        new() { Key = "run", Label = "Run", Icon = "thunderbolt" },
        new() { Key = "retry", Label = "Retry", Icon = "reload" },
        new() { Key = "abort", Label = "Abort", Icon = "pause-circle", Danger = true },
        new() { Key = "reset", Label = "Reset", Icon = "delete", Danger = true }
    ];

    private IReadOnlyList<XActionItem> ConversationMenuItems =>
    [
        new() { Key = "archive", Icon = "inbox", Tooltip = "Archive" },
        new() { Key = "pin", Icon = "pushpin", Tooltip = "Pin" }
    ];

    private IReadOnlyList<XActionItem> ConversationSortActions =>
    [
        new() { Key = "newest", Icon = "sort-ascending", Tooltip = "Newest first" },
        new() { Key = "oldest", Icon = "sort-descending", Tooltip = "Oldest first" }
    ];

    private IReadOnlyDictionary<string, XBubbleRoleConfig> BubbleRoleConfigs =>
        new Dictionary<string, XBubbleRoleConfig>(StringComparer.OrdinalIgnoreCase)
        {
            ["assistant"] = new XBubbleRoleConfig
            {
                Placement = XBubblePlacement.Start,
                Variant = XBubbleVariant.Filled,
                Shape = XBubbleShape.Round,
                AvatarIcon = "robot",
                Header = "Assistant",
                Markdown = true,
            },
            ["user"] = new XBubbleRoleConfig
            {
                Placement = XBubblePlacement.End,
                Variant = XBubbleVariant.Outlined,
                Shape = XBubbleShape.Corner,
                AvatarIcon = "user",
                Header = "You",
                Markdown = true,
            },
            ["system"] = new XBubbleRoleConfig
            {
                Placement = XBubblePlacement.Start,
                Variant = XBubbleVariant.Borderless,
                Shape = XBubbleShape.Default,
                Header = "System",
                Markdown = true,
            },
            ["divider"] = new XBubbleRoleConfig
            {
                Placement = XBubblePlacement.Start,
                Variant = XBubbleVariant.Borderless,
                Shape = XBubbleShape.Default,
            }
        };

    private RenderFragment SenderHeaderTemplate => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "demo-sender-header");
        builder.OpenElement(2, "span");
        builder.AddContent(3, "Composer");
        builder.CloseElement();
        builder.OpenComponent<XActions>(4);
        builder.AddAttribute(5, "Items", SenderHeaderActions);
        builder.AddAttribute(6, "IconOnly", true);
        builder.AddAttribute(7, "Size", "small");
        builder.AddAttribute(8, "OnAction", EventCallback.Factory.Create<string>(this, HandleSenderHeaderAction));
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment ConversationSortTemplate => builder =>
    {
        builder.OpenComponent<XActions>(0);
        builder.AddAttribute(1, "Items", ConversationSortActions);
        builder.AddAttribute(2, "IconOnly", true);
        builder.AddAttribute(3, "OnAction", EventCallback.Factory.Create<string>(this, HandleConversationSortAction));
        builder.CloseComponent();
    };

    protected override void OnInitialized()
    {
        ChatStore.Changed += HandleStoresChanged;
        AgentStore.Changed += HandleStoresChanged;
        ChatStore.ConversationKey = ActiveConversation;
        AgentStore.AgentKey = ActiveConversation;
        ChatStore.ReplaceMessages(SeedMessages());
        AgentStore.Reset();
    }

    public void Dispose()
    {
        ChatStore.Changed -= HandleStoresChanged;
        AgentStore.Changed -= HandleStoresChanged;
    }

    private void HandleStoresChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<XBubbleItem> SeedMessages() =>
        [
            new()
            {
                Key = "system",
                Role = "system",
                Content = "System ready. Try sending a message or opening the action menus.",
                Status = XMessageStatus.Local
            },
            new()
            {
                Key = "m1",
                Role = "assistant",
                Header = "Ant Design X",
                Placement = XBubblePlacement.Start,
                Content = "你好，我是 **Ant Design X Blazor** 示例。下面这些组件可以直接组合成 AI 工作台。",
                Actions = MessageActions
            },
            new()
            {
                Key = "divider-today",
                Role = "divider",
                Header = "Today"
            },
            new()
            {
                Key = "m2",
                Role = "user",
                Placement = XBubblePlacement.End,
                Content = "请演示附件、来源和思考链。"
            },
            new()
            {
                Key = "m3",
                Role = "assistant",
                Header = "Composer",
                Placement = XBubblePlacement.Start,
                Variant = XBubbleVariant.Shadow,
                Content = "可以。`XSender` 负责输入，`XAttachments` 展示草稿文件，`XThoughtChain` 呈现推理步骤，`XSources` 呈现引用来源。",
                Attachments = new[] { DoneFile },
                Actions = MessageActions
            }
        ];

    private IReadOnlyList<XThoughtItem> Thoughts =>
    [
        new() { Key = "1", Title = "识别意图", Description = "用户想看组件闭环", Status = XSemanticStatus.Success },
        new() { Key = "2", Title = "收集上下文", Description = "读取提示词、附件与会话状态", Status = XSemanticStatus.Processing },
        new() { Key = "3", Title = "生成回答", Description = "组合 Markdown、Sources 与 Actions", Status = XSemanticStatus.Default }
    ];

    private IReadOnlyList<XSourceItem> Sources =>
    [
        new() { Key = "x", Title = "Ant Design X", Description = "官方 React 设计与组件语义", Url = "https://x.ant.design/", Icon = "ant-design" },
        new() { Key = "b", Title = "AntDesign.Blazor", Description = "Blazor 基础组件生态", Url = "https://antblazor.com/", Icon = "dot-chart" }
    ];

    private IReadOnlyList<XFolderItem> Folders =>
    [
        new()
        {
            Key = "components",
            Name = "Components",
            Icon = "folder",
            Children =
            [
                new() { Key = "bubble", Name = "Bubble", Description = "消息气泡" },
                new() { Key = "sender", Name = "Sender", Description = "输入框" },
                new() { Key = "sources", Name = "Sources", Description = "引用来源" }
            ]
        },
        new() { Key = "sdk", Name = "SDK", Description = "XRequest / XStream / useXChat 映射" }
    ];

    private XAttachmentItem UploadingFile => new()
    {
        Id = "uploading",
        Name = "analysis.csv",
        Description = "Uploading",
        Size = 184320,
        Status = XFileCardStatus.Uploading,
        Percent = 68,
        ContentType = "text/csv"
    };

    private XAttachmentItem DoneFile => new()
    {
