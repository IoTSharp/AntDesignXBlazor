    private async Task UsePrompt(XPromptItem prompt)
    {
        Draft = prompt.Title;
        if (string.Equals(prompt.Key, "rag", StringComparison.OrdinalIgnoreCase))
        {
            await RunAgentScenarioAsync(prompt.Description ?? prompt.Title);
        }

        await NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Prompt: {prompt.Title}",
            Description = prompt.Description,
            Status = XSemanticStatus.Success
        });
    }

    private async Task HandleSenderHeaderAction(string key)
    {
        await NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Header action: {key}",
            Description = "Sender header action invoked.",
            Status = XSemanticStatus.Default
        });
    }

    private Task SetActiveConversation(string key)
    {
        ActiveConversation = key;
        ChatStore.ConversationKey = key;
        AgentStore.AgentKey = key;
        return Task.CompletedTask;
    }

    private Task SetActiveFolder(string key)
    {
        ActiveFolder = key;
        return Task.CompletedTask;
    }

    private async Task Submit(XSenderRequest request)
    {
        TouchConversation(ActiveConversation, request.Text);
        await NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "Submitted",
            Description = request.Text,
            Status = XSemanticStatus.Processing
        });
        await ChatStore.SubmitAsync(request);
    }

    private async Task Stop()
    {
        await ChatStore.AbortAsync();
    }

    private Task ClearDraft()
    {
        Draft = string.Empty;
        DraftAttachments.Clear();
        return Task.CompletedTask;
    }

    private Task AddFiles(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            DraftAttachments.Add(new XAttachmentItem
            {
                Id = Guid.NewGuid().ToString("N"),
                Name = file.Name,
                Description = file.ContentType,
                Size = file.Size,
                Status = XFileCardStatus.Done,
                ContentType = file.ContentType
            });
        }

        return Task.CompletedTask;
    }

    private ValueTask<bool> BeforeUpload(IBrowserFile file)
    {
        const long MaxFileSize = 5 * 1024 * 1024;
        if (file.Size <= MaxFileSize)
        {
            return ValueTask.FromResult(true);
        }

        _ = NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "File skipped",
            Description = $"{file.Name} is larger than 5 MB.",
            Status = XSemanticStatus.Warning
        });

        return ValueTask.FromResult(false);
    }

    private Task RemoveAttachment(string id)
    {
        DraftAttachments.RemoveAll(item => item.Id == id);
        return Task.CompletedTask;
    }

    private Task HandleSenderAction(string key)
    {
        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Action: {key}",
            Description = "Sender action invoked.",
            Status = XSemanticStatus.Default
        });
    }

    private async Task HandleMessageAction(string key)
    {
        if (string.Equals(key, "reload", StringComparison.OrdinalIgnoreCase))
        {
            await ChatStore.RetryAsync();
        }

        await NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Message action: {key}",
            Description = "Bubble action invoked.",
            Status = XSemanticStatus.Success
        });
    }

    private async Task HandleAgentMessageAction(string key)
    {
        if (string.Equals(key, "reload", StringComparison.OrdinalIgnoreCase))
        {
            await AgentStore.RetryAsync();
        }

        await NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Agent action: {key}",
            Description = "Agent bubble action invoked.",
            Status = XSemanticStatus.Success
        });
    }

    private Task HandleAgentToolAction(string key)
    {
        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Tool call: {key}",
            Description = "Tool call summary clicked.",
            Status = XSemanticStatus.Default
        });
    }

    private async Task HandleAgentAction(string key)
    {
        switch (key)
        {
            case "run":
                await RunAgentScenarioAsync("请解释当前 SDK 闭环如何工作，并输出思考、工具调用和来源。");
                break;
            case "retry":
                await AgentStore.RetryAsync();
                break;
            case "abort":
                await AgentStore.AbortAsync();
                break;
            case "reset":
                AgentStore.Reset();
                break;
        }

        await NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Agent action: {key}",
            Description = "Agent control invoked.",
            Status = XSemanticStatus.Default
        });
    }

    private Task CloseNotification(string key)
    {
        Notifications.RemoveAll(item => item.Key == key);
        return Task.CompletedTask;
    }

    private Task HandleConversationMenuAction(XConversationActionRequest request)
    {
        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = $"Conversation action: {request.ActionKey}",
            Description = request.ConversationKey,
            Status = XSemanticStatus.Default
        });
    }

    private Task HandleConversationDelete(XConversationItem item)
    {
        ConversationItems.RemoveAll(value => value.Key == item.Key);
        if (ActiveConversation == item.Key)
        {
            ActiveConversation = ConversationItems.FirstOrDefault()?.Key ?? string.Empty;
            ChatStore.ConversationKey = ActiveConversation;
            AgentStore.AgentKey = ActiveConversation;
        }

        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "Conversation deleted",
            Description = item.Title,
            Status = XSemanticStatus.Warning
        });
    }

    private Task HandleConversationRename(XConversationRenameRequest request)
    {
        var index = ConversationItems.FindIndex(item => item.Key == request.Key);
        if (index >= 0)
        {
            ConversationItems[index] = ConversationItems[index] with
            {
                Title = request.Title,
                UpdatedAt = DateTimeOffset.UtcNow,
            };
        }

        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "Conversation renamed",
            Description = request.Title,
            Status = XSemanticStatus.Success
        });
    }

    private Task HandleConversationSortAction(string key)
    {
        ConversationSortDescending = !string.Equals(key, "oldest", StringComparison.OrdinalIgnoreCase);
        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "Conversation sorted",
            Description = ConversationSortDescending ? "Newest first" : "Oldest first",
            Status = XSemanticStatus.Default
        });
    }

    private async Task RunAgentScenarioAsync(string prompt)
    {
        AgentStore.AgentKey = ActiveConversation;
        await AgentStore.RunAsync(new XAgentRequest
        {
            Prompt = prompt,
            Attachments = DraftAttachments.Select(item => item with { }).ToArray(),
            Metadata = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["conversation"] = ActiveConversation,
                ["source"] = "demo",
            },
        });
    }

    private void TouchConversation(string key, string? preview)
    {
        var index = ConversationItems.FindIndex(item => item.Key == key);
        if (index < 0)
        {
            return;
        }

        var current = ConversationItems[index];
        var description = string.IsNullOrWhiteSpace(preview)
            ? current.Description
            : preview.Length > 48
                ? $"{preview[..48]}..."
                : preview;
        ConversationItems[index] = current with
        {
            Count = (current.Count ?? 0) + 1,
            UpdatedAt = DateTimeOffset.UtcNow,
            Description = description,
        };
    }
}
