    private Task HandleConversationDelete(XConversationItem item)
    {
        ConversationItems.RemoveAll(value => value.Key == item.Key);
        if (ActiveConversation == item.Key)
        {
            ActiveConversation = ConversationItems.FirstOrDefault()?.Key ?? string.Empty;
            ChatStore.ConversationKey = ActiveConversation;
            AgentStore.AgentKey = ActiveConversation;
        }

        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "Conversation deleted",
            Description = item.Title,
            Status = XSemanticStatus.Warning
        });
    }

    private Task HandleConversationRename(XConversationRenameRequest request)
    {
        var index = ConversationItems.FindIndex(item => item.Key == request.Key);
        if (index >= 0)
        {
            ConversationItems[index] = ConversationItems[index] with
            {
                Title = request.Title,
                UpdatedAt = DateTimeOffset.UtcNow,
            };
        }

        return NotificationService.OpenAsync(new XNotificationItem
        {
            Key = Guid.NewGuid().ToString("N"),
            Title = "Conversation renamed",
            Description = request.Title,
            Status = XSemanticStatus.Success
        });
    }

