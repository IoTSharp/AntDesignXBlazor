@page "/"
@implements IDisposable
@inject IXNotificationService NotificationService
@inject XChatStore ChatStore
@inject XAgentStore AgentStore
@inject NavigationManager Nav

<PageTitle>首页 · AntDesign.X.Blazor</PageTitle>

<section class="demo-hero">
    <div class="demo-kicker">Ant Design X 2.x for Blazor</div>
    <h1>面向 AI 对话产品的 Blazor 组件门面</h1>
    <p>这个示例应用覆盖 Bubble、Conversations、Sender、Attachments、Prompts、ThoughtChain、Think、Suggestion、Sources、FileCard、Folder、Notification、Markdown、CodeHighlighter 与 Mermaid。每块都展示真实交互和可复制的写法。</p>
</section>

<section id="experience" class="demo-section">
    <h2>完整工作台体验</h2>
    <div class="demo-chat">
        <XConversations Items="@Conversations"
                        ActiveKey="@ActiveConversation"
                        ActiveKeyChanged="@SetActiveConversation"
                        Title="Conversations"
                        Extra="Blazor"
                        SortTemplate="@ConversationSortTemplate"
                        MenuItems="@ConversationMenuItems"
                        OnMenuAction="@HandleConversationMenuAction"
                        OnDelete="@HandleConversationDelete"
                        OnRename="@HandleConversationRename" />
        <div class="demo-chat-main">
            <XWelcome Title="Ant Design X Blazor"
                      Description="保持 Ant Design X 的对话产品语义，用纯 Blazor 和 AntDesign.Blazor 交付。"
                      Icon="robot">
                <XPrompts Items="@Prompts"
                          Wrap="true"
                          ExpandAllByDefault="true"
                          OnItemClick="@UsePrompt" />
            </XWelcome>
            <div class="demo-chat-scroll">
                <XBubbleList Items="@ChatStore.Messages"
                             RoleConfigs="@BubbleRoleConfigs"
                             Loading="@ChatStore.IsLoading"
                             OnAction="@HandleMessageAction" />
            </div>
            <XSender @bind-Value="@Draft"
                     Attachments="@DraftAttachments"
                     Actions="@SenderActions"
                     Loading="@ChatStore.IsLoading"
                     AutoSize="true"
                     ClearAfterSubmit="true"
                     Clearable="true"
                     HeaderVisible="true"
                     HeaderTemplate="@SenderHeaderTemplate"
                     HeaderCollapsible="true"
                     FooterCollapsible="true"
                     SubmitMode="XSenderSubmitMode.Enter"
                     AttachmentsPastable="true"
                     AttachmentsDragHover="true"
                     BeforeUpload="@BeforeUpload"
                     OnSubmit="@Submit"
                     OnCancel="@Stop"
                     OnClear="@ClearDraft"
                     OnAction="@HandleSenderAction"
                     OnFilesSelected="@AddFiles"
                     OnAttachmentRemove="@RemoveAttachment" />
        </div>
    </div>
</section>

<section id="display" class="demo-section">
    <h2>展示组件</h2>
    <div class="demo-grid">
        <XThoughtChain Title="ThoughtChain"
                       Items="@Thoughts" />
        <div>
            <XThink Title="Think"
                    Description="可折叠推理过程"
                    Status="XSemanticStatus.Processing"
                    Content="@ThinkContent" />
        </div>
        <XSources Items="@Sources" />
        <XFolder Title="Folder"
                 Variant="XFolderVariant.Card"
                 Items="@Folders"
                 ActiveKey="@ActiveFolder"
                 ActiveKeyChanged="@SetActiveFolder" />
    </div>
</section>

<section id="input" class="demo-section">
    <h2>输入与建议</h2>
    <div class="demo-grid">
        <XAttachments Title="Attachments"
                      Items="@DraftAttachments"
                      UploadEnabled="true"
                      DragHover="true"
                      Pastable="true"
                      BeforeUpload="@BeforeUpload"
                      OnFilesSelected="@AddFiles"
                      OnRemove="@RemoveAttachment" />
        <XSuggestion Query="@Draft"
                     Items="@Prompts"
                     OnSelect="@UsePrompt" />
    </div>
</section>

<section id="feedback" class="demo-section">
    <h2>反馈与状态</h2>
    <div class="demo-grid">
        <XFileCard Item="@UploadingFile" />
        <XFileCard Item="@DoneFile" />
        <XActions Items="@MessageActions"
                  OnAction="@HandleMessageAction" />
    </div>
    <XNotification Items="@Notifications"
                   Placement="XNotificationPlacement.TopRight"
                   MaxCount="4"
                   DefaultDuration="@TimeSpan.FromSeconds(4)"
                   OnClose="@CloseNotification" />
</section>

<section id="playground" class="demo-section">
    <div class="demo-playground-header">
        <div>
            <h2>Playground 实战范例</h2>
        </div>
        <div class="demo-playground-tabs" role="tablist" aria-label="Playground 实战范例">
            @foreach (var item in PlaygroundOptions)
            {
                <button type="button"
                        class="demo-playground-tab @(IsPlaygroundActive(item.Key) ? "active" : null)"
                        @onclick="() => SelectPlayground(item.Key)">
                    <Icon Type="@item.Icon" Theme="IconThemeType.Outline" />
                    <span>@item.Title</span>
                </button>
            }
        </div>
    </div>
    <div class="demo-playground-panel">
        @switch (SelectedPlaygroundKey)
        {
            case PlaygroundIndependentKey:
                <PlaygroundIndependentDemo />
                break;
            case PlaygroundCopilotKey:
                <PlaygroundCopilotDemo />
                break;
            default:
                <PlaygroundUltramodernDemo />
                break;
        }
    </div>
</section>

<section id="sdk" class="demo-section">
    <h2>SDK 闭环</h2>
    <div class="demo-grid">
        <div class="demo-agent-panel">
            <div class="demo-sender-header">
                <span>Agent Trace</span>
                <XActions Items="@AgentActions"
                          IconOnly="true"
                          Size="small"
                          OnAction="@HandleAgentAction" />
            </div>
            <XBubbleList Items="@AgentStore.Messages"
                         RoleConfigs="@BubbleRoleConfigs"
                         Loading="@AgentStore.IsRunning"
                         OnAction="@HandleAgentMessageAction" />
            <XActions Items="@AgentStore.ToolActions"
                      OnAction="@HandleAgentToolAction" />
        </div>
        <XThoughtChain Title="ThoughtChain"
                       Items="@AgentStore.Thoughts" />
        <XSources Items="@AgentStore.Sources" />
        <div class="demo-agent-events">
            <div class="demo-agent-events-title">Recent events</div>
            @if (AgentStore.Events.Count == 0)
            {
                <p>Run an agent trace to see thoughts, tool calls, and sources appear here.</p>
            }
            else
            {
                <ul>
                    @foreach (var item in AgentStore.Events.Reverse().Take(6))
                    {
                        <li>
                            <strong>@item.Kind</strong>
                            <span>@item.Title</span>
                            @if (!string.IsNullOrWhiteSpace(item.Content))
                            {
                                <small>@item.Content</small>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

<section id="markdown" class="demo-section">
    <h2>Markdown、代码与图</h2>
    <div class="demo-code-grid">
        <XMarkdown Content="@MarkdownSample" />
        <XCodeHighlighter Language="razor"
                          Code="@BubbleCode" />
        <XMermaid Definition="@MermaidDefinition" />
    </div>
</section>

<section id="code" class="demo-section">
    <h2>最小使用代码</h2>
    <XCodeHighlighter Language="razor"
                      Code="@SenderCode" />
</section>

