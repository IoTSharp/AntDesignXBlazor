    private RenderFragment SenderHeaderTemplate => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "demo-sender-header");
        builder.OpenElement(2, "span");
        builder.AddContent(3, "Composer");
        builder.CloseElement();
        builder.OpenComponent<XActions>(4);
        builder.AddAttribute(5, "Items", SenderHeaderActions);
        builder.AddAttribute(6, "IconOnly", true);
        builder.AddAttribute(7, "Size", "small");
        builder.AddAttribute(8, "OnAction", EventCallback.Factory.Create<string>(this, HandleSenderHeaderAction));
        builder.CloseComponent();
        builder.CloseElement();
    };

    private RenderFragment ConversationSortTemplate => builder =>
    {
        builder.OpenComponent<XActions>(0);
        builder.AddAttribute(1, "Items", ConversationSortActions);
        builder.AddAttribute(2, "IconOnly", true);
        builder.AddAttribute(3, "OnAction", EventCallback.Factory.Create<string>(this, HandleConversationSortAction));
        builder.CloseComponent();
    };

    protected override void OnInitialized()
    {
        ChatStore.Changed += HandleStoresChanged;
        AgentStore.Changed += HandleStoresChanged;
        ChatStore.ConversationKey = ActiveConversation;
        AgentStore.AgentKey = ActiveConversation;
        ChatStore.ReplaceMessages(SeedMessages());
        AgentStore.Reset();
    }

    protected override void OnParametersSet()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("playground", out var value))
        {
            var key = value.ToString().Trim().ToLowerInvariant();
            SelectedPlaygroundKey = key switch
            {
                PlaygroundIndependentKey => PlaygroundIndependentKey,
                PlaygroundCopilotKey => PlaygroundCopilotKey,
                _ => PlaygroundUltramodernKey,
            };
        }
        else if (string.IsNullOrWhiteSpace(SelectedPlaygroundKey))
        {
            SelectedPlaygroundKey = PlaygroundUltramodernKey;
        }
    }

    public void Dispose()
    {
        ChatStore.Changed -= HandleStoresChanged;
        AgentStore.Changed -= HandleStoresChanged;
    }

    private void HandleStoresChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectPlayground(string key)
    {
        Nav.NavigateTo($"/?playground={key}#playground");
    }

    private bool IsPlaygroundActive(string key)
    {
        return string.Equals(SelectedPlaygroundKey, key, StringComparison.OrdinalIgnoreCase);
    }

