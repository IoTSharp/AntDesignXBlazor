@page "/components/think"
@layout ComponentLayout

<PageTitle>Think 思考 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Think 思考</h1>
    <p>展示模型推理过程的可折叠区块，支持状态、Markdown 渲染。</p>
</header>

<DemoCard Title="基础"
          Description="Processing 状态 + 默认展开。"
          SourceCode="@BasicSource">
    <XThink Title="思考中"
            Description="正在分析问题"
            Content="1. 拆解任务\n2. 查找资料\n3. 给出结论"
            Status="XSemanticStatus.Processing" />
</DemoCard>

<DemoCard Title="完成态 + 默认折叠"
          Description="Open=false。"
          SourceCode="@DoneSource">
    <XThink Title="已完成"
            Content="基于以上分析，建议采用方案 A。"
            Status="XSemanticStatus.Success"
            Open="false" />
</DemoCard>

<DemoCard Title="错误态"
          Description="Status=Error。"
          SourceCode="@ErrorSource">
    <XThink Title="思考失败"
            Content="检索资料时发生错误，已中断。"
            Status="XSemanticStatus.Error" />
</DemoCard>

<DemoCard Title="嵌入 ChildContent"
          Description="ChildContent 自定义内容。"
          SourceCode="@CustomSource">
    <XThink Title="多步推理" Status="XSemanticStatus.Processing">
        <XThoughtChain Items="@_chain" Size="small" />
    </XThink>
</DemoCard>

@code {
    private readonly IReadOnlyList<XThoughtItem> _chain =
    [
        new() { Title = "解析输入", Status = XSemanticStatus.Success },
        new() { Title = "检索知识库", Status = XSemanticStatus.Success },
        new() { Title = "生成答案", Status = XSemanticStatus.Processing },
    ];

    private const string BasicSource = """
<XThink Title="..." Content="..." Status="XSemanticStatus.Processing" />
""";
    private const string DoneSource = """
<XThink Status="XSemanticStatus.Success" Open="false" />
""";
    private const string ErrorSource = """
<XThink Status="XSemanticStatus.Error" />
""";
    private const string CustomSource = """
<XThink ...>
    <XThoughtChain Items="@items" />
</XThink>
""";
}
