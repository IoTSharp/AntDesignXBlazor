@page "/components/welcome"
@layout ComponentLayout

<PageTitle>Welcome 欢迎 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Welcome 欢迎</h1>
    <p>对话引导页头部，常与 Prompts / Sender 组合使用。</p>
</header>

<DemoCard Title="基础用法"
          Description="Title + Description + Icon。"
          SourceCode="@BasicSource">
    <XWelcome Title="你好，我是 AntDesign.X for Blazor"
              Description="请描述你想完成的任务，我会帮你拆解步骤并给出回答。" />
</DemoCard>

<DemoCard Title="搭配 Prompts"
          Description="ExtraTemplate 嵌入快捷入口。"
          SourceCode="@PromptSource">
    <XWelcome Title="开始一段对话" Description="选择一个常用提示快速开始：">
        <ExtraTemplate>
            <XPrompts Items="@_prompts" />
        </ExtraTemplate>
    </XWelcome>
</DemoCard>

<DemoCard Title="自定义图标 + 紧凑"
          Description="IconTemplate 与 Compact 组合。"
          SourceCode="@CustomSource">
    <XWelcome Compact="true"
              Title="Hi, Camel"
              Description="Compact 适合放进侧边栏或卡片。">
        <IconTemplate>
            <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#1677ff,#69b1ff);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;">X</div>
        </IconTemplate>
    </XWelcome>
</DemoCard>

@code {
    private readonly IReadOnlyList<XPromptItem> _prompts =
    [
        new() { Title = "总结这段会议", Description = "上传纪要后获取摘要", Icon = "file-text" },
        new() { Title = "解释代码", Description = "粘贴代码片段", Icon = "code" },
        new() { Title = "翻译为英文", Description = "保留专业术语", Icon = "translation" },
    ];

    private const string BasicSource = """
<XWelcome Title="..." Description="..." />
""";
    private const string PromptSource = """
<XWelcome ...>
    <ExtraTemplate><XPrompts Items="@items" /></ExtraTemplate>
</XWelcome>
""";
    private const string CustomSource = """
<XWelcome Compact="true">
    <IconTemplate><div>...</div></IconTemplate>
</XWelcome>
""";
}
