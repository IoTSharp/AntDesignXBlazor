@page "/components/code-highlighter"
@layout ComponentLayout

<PageTitle>Code Highlighter 代码高亮 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Code Highlighter 代码高亮</h1>
    <p>独立的代码块高亮组件，也被 XMarkdown 内部使用。</p>
</header>

<DemoCard Title="C#" SourceCode="@CsharpSource">
    <XCodeHighlighter Language="csharp" Code="@CsharpCode" />
</DemoCard>

<DemoCard Title="Razor" SourceCode="@RazorSource">
    <XCodeHighlighter Language="razor" Code="@RazorCode" />
</DemoCard>

<DemoCard Title="JSON / 不显示头部" SourceCode="@JsonSource">
    <XCodeHighlighter Language="json" Code="@JsonCode" ShowHeader="false" />
</DemoCard>

<DemoCard Title="行号"
          Description="ShowLineNumbers 启用左侧行号列。"
          SourceCode="@LineNumbersSource">
    <XCodeHighlighter Language="@_lnLang" Code="@CurrentLnCode" ShowLineNumbers="true" />
    <div class="demo-toolbar">
        @foreach (var lang in _lnLanguages)
        {
            <button class="demo-button @(lang == _lnLang ? "demo-button-active" : null)"
                    @onclick="() => _lnLang = lang">@lang</button>
        }
    </div>
</DemoCard>

<DemoCard Title="流式"
          Description="Streaming 在末尾追加闪烁光标，可与逐字 push 结合。"
          SourceCode="@StreamingSource">
    <XCodeHighlighter Language="csharp" Code="@_streamingCode" Streaming="@_streaming" ShowLineNumbers="true" />
    <div class="demo-toolbar">
        <button class="demo-button" @onclick="StartStreamAsync" disabled="@_streaming">开始流式输出</button>
        <button class="demo-button" @onclick="ResetStream">重置</button>
    </div>
</DemoCard>

@code {
    private string _lnLang = "csharp";
    private static readonly string[] _lnLanguages = ["csharp", "razor", "json"];
    private string CurrentLnCode => _lnLang switch
    {
        "razor" => RazorCode,
        "json" => JsonCode,
        _ => CsharpCode,
    };

    private string _streamingCode = string.Empty;
    private bool _streaming;

    private async Task StartStreamAsync()
    {
        _streamingCode = string.Empty;
        _streaming = true;
        StateHasChanged();
        foreach (var ch in CsharpCode)
        {
            _streamingCode += ch;
            StateHasChanged();
            await Task.Delay(15);
        }
        _streaming = false;
    }

    private void ResetStream()
    {
        _streaming = false;
        _streamingCode = string.Empty;
    }

    private const string CsharpCode = """
using AntDesign.X;

public sealed record Greeting(string Name)
{
    public string Hello() => $"Hello, {Name}!";
}
""";

    private const string RazorCode = """
<XBubbleList Items="@msgs" RoleConfigs="@roles" />
<XSender @bind-Value="@draft" OnSubmit="@send" />
""";

    private const string JsonCode = """
{
  "model": "gpt-x",
  "stream": true,
  "messages": [{ "role": "user", "content": "hi" }]
}
""";

    private const string CsharpSource = """<XCodeHighlighter Language="csharp" Code="@CsharpCode" />""";
    private const string RazorSource  = """<XCodeHighlighter Language="razor"  Code="@RazorCode" />""";
    private const string JsonSource   = """<XCodeHighlighter Language="json"   Code="@JsonCode" ShowHeader="false" />""";
    private const string LineNumbersSource = """<XCodeHighlighter Language="csharp" Code="@code" ShowLineNumbers="true" />""";
    private const string StreamingSource = """<XCodeHighlighter Language="csharp" Code="@buffer" Streaming="@isStreaming" ShowLineNumbers="true" />""";
}
