@page "/components/file-card"
@layout ComponentLayout

<PageTitle>FileCard 文件卡 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>FileCard 文件卡</h1>
    <p>展示单个附件，可显示进度、状态、可移除。</p>
</header>

<DemoCard Title="状态" SourceCode="@StatusSource">
    <XFileCard Item="@Done" />
    <XFileCard Item="@Uploading" />
    <XFileCard Item="@Error" />
</DemoCard>

<DemoCard Title="紧凑 + 可移除" SourceCode="@CompactSource">
    <XFileCard Item="@Done" Compact="true" Removable="true" OnRemove="@(id => _removed = id)" />
    @if (!string.IsNullOrEmpty(_removed))
    {
        <p class="demo-tip">移除：<code>@_removed</code></p>
    }
</DemoCard>

@code {
    private string? _removed;

    private XAttachmentItem Done { get; } = new() { Name = "spec.pdf", Size = 204800, ContentType = "application/pdf", Status = XFileCardStatus.Done };
    private XAttachmentItem Uploading { get; } = new() { Name = "video.mp4", Size = 5_242_880, ContentType = "video/mp4", Status = XFileCardStatus.Uploading, Percent = 42 };
    private XAttachmentItem Error { get; } = new() { Name = "broken.zip", Size = 12_345, ContentType = "application/zip", Status = XFileCardStatus.Error };

    private const string StatusSource = """
<XFileCard Item="@Done" />
<XFileCard Item="@Uploading" />
<XFileCard Item="@Error" />
""";

    private const string CompactSource = """
<XFileCard Item="@Done" Compact="true" Removable="true" OnRemove="@(id => _removed = id)" />
""";
}
