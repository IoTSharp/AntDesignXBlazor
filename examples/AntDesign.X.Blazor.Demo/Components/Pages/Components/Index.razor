@page "/components"
@page "/components/introduce-cn"
@page "/component/overview"
@layout ComponentLayout

<PageTitle>总览 · AntDesign.X.Blazor</PageTitle>

<h1>总览</h1>

<p><code>AntDesign.X.Blazor</code> 是 <code>Ant Design X</code> 面向 Blazor 生态的实现，专注于帮助开发者快速构建 AI 对话、Copilot 和混合界面体验。组件库使用 AntDesign.Blazor 作为基础设计系统，并提供面向 AI 交互的语义组件与数据模型。</p>

<DocsDemo Title="组件总览" SourceCode="@OverviewSource">
    <div class="overview-cards">
        @foreach (var group in ComponentNav.Groups)
        {
            <section class="overview-group">
                <h2>@group.Title</h2>
                <div class="overview-grid">
                    @foreach (var item in group.Items)
                    {
                        <a class="overview-card" href="@($"component/{item.Slug}")">
                            <span>@item.EnglishTitle</span>
                            <small>@item.Title</small>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
</DocsDemo>

<section id="api">
    <h2>快速开始</h2>
    <p>注册服务、引入样式后，用 XProvider 包裹页面，就可以像下面这样组合一个最小输入闭环。</p>
    <XCodeHighlighter Language="razor"
                      Code="@QuickStartCode" />
</section>

@code {
    private const string OverviewSource = """
<XWelcome Title="Ant Design X Blazor" Description="AI components for Blazor" />
<XBubbleList Items="@messages" />
<XSender @bind-Value="@draft" OnSubmit="@Submit" />
""";

    private const string QuickStartCode = """
<XProvider Theme="light">
    <XBubbleList Items="@messages" />
    <XSender @bind-Value="@draft"
             Attachments="@attachments"
             OnSubmit="@Submit"
             OnFilesSelected="@AddFiles" />
</XProvider>
""";
}
