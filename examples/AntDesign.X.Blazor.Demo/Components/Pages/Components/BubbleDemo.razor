@page "/components/bubble"
@page "/component/bubble"
@layout ComponentLayout
@implements IDisposable

<PageTitle>Bubble 对话气泡 · AntDesign.X.Blazor</PageTitle>

<h1>Bubble 对话气泡</h1>
<p>用于聊天的气泡组件。</p>

<section id="when-to-use">
    <h2>何时使用</h2>
    <p>常用于聊天的时候。</p>
</section>

<section id="examples">
    <h2>代码演示</h2>

<DemoCard Title="基本"
          Description="基础用法。"
          SourceCode="@BasicSource">
    <XBubble Content="Hello, Ant Design X for Blazor!" />
    <XBubble Content="你好，这是一段中文消息。" Placement="XBubblePlacement.End" />
</DemoCard>

<DemoCard Title="支持位置和头像"
          Description="通过 avatar 设置自定义头像，通过 placement 设置位置，提供了 start、end 两个选项。"
          SourceCode="@AvatarSource">
    <XBubble Content="我是助手" Header="Assistant" AvatarIcon="robot"
             Placement="XBubblePlacement.Start" Variant="XBubbleVariant.Filled" Shape="XBubbleShape.Round" />
    <XBubble Content="我是用户" Header="User" AvatarIcon="user"
             Placement="XBubblePlacement.End" Variant="XBubbleVariant.Outlined" Shape="XBubbleShape.Round" />
</DemoCard>

<DemoCard Title="头和尾"
          Description="通过 header 和 footer 属性设置气泡的头部和底部。"
          SourceCode="@HeaderFooterSource">
    <XBubble Header="Ant Design X"
             Content="With header and footer."
             AvatarIcon="robot">
        <FooterTemplate>
            <span>Footer content</span>
        </FooterTemplate>
    </XBubble>
</DemoCard>

<DemoCard Title="加载中"
          Description="通过 loading 属性控制加载状态。"
          SourceCode="@LoadingSource">
    <XBubble Loading="true" Header="Assistant" AvatarIcon="robot" />
</DemoCard>

<DemoCard Title="打字效果"
          Description="通过设置 typing 属性，开启打字效果。更新 content 如果是之前的子集，则会继续输出，否则会重新输出。"
          SourceCode="@TypingSource">
    <XBubble Header="Assistant" AvatarIcon="robot" Streaming="true"
             Status="XMessageStatus.Loading" Markdown="true" Content="@_typing" />
    <div class="demo-actions">
        <button class="demo-btn" type="button" @onclick="StartTyping">Restart</button>
    </div>
</DemoCard>

<DemoCard Title="自定义渲染内容"
          Description="自定义渲染内容。"
          SourceCode="@CustomRenderSource">
    <XBubble Header="Assistant" AvatarIcon="robot">
        <ContentTemplate>
            <div class="demo-card-inset">
                <p>下面是我推理的过程：</p>
                <XThoughtChain Items="@_steps" Compact="true" />
                <p><strong>结论</strong>：使用 <code>XBubbleList</code> + <code>XSender</code> 组合即可。</p>
            </div>
        </ContentTemplate>
    </XBubble>
</DemoCard>

<DemoCard Title="渲染markdown内容"
          Description="配合 markdown-it 实现自定义渲染内容。"
          SourceCode="@MarkdownSource">
    <XBubble Markdown="true" Header="Assistant" AvatarIcon="robot" Content="@MarkdownContent" />
</DemoCard>

<DemoCard Title="变体"
          Description="通过 variant 属性设置气泡的样式变体。"
          SourceCode="@VariantSource">
    <XBubble Content="Filled" Variant="XBubbleVariant.Filled" />
    <XBubble Content="Outlined" Variant="XBubbleVariant.Outlined" />
    <XBubble Content="Borderless" Variant="XBubbleVariant.Borderless" />
    <XBubble Content="Shadow" Variant="XBubbleVariant.Shadow" />
</DemoCard>

<DemoCard Title="形状"
          Description="通过 shape 属性设置气泡的形状。"
          SourceCode="@ShapeSource">
    <XBubble Content="Round bubble" Shape="XBubbleShape.Round" />
    <XBubble Content="Corner bubble" Shape="XBubbleShape.Corner" />
</DemoCard>

<DemoCard Title="气泡列表"
          Description="预设样式的气泡列表，支持自动滚动。使用 roles 设置气泡默认属性。"
          SourceCode="@ListSource">
    <XBubbleList Items="@ListItems" RoleConfigs="@RoleConfigs" />
</DemoCard>

<DemoCard Title="语义化自定义"
          Description="示例通过语义化以及加载定制，来调整气泡效果。"
          SourceCode="@StatusSource">
    <XBubble Header="Loading" AvatarIcon="robot" Loading="true" Status="XMessageStatus.Loading" />
    <XBubble Header="Success" AvatarIcon="robot" Content="生成完成。" Status="XMessageStatus.Success" />
    <XBubble Header="Error" AvatarIcon="robot" Content="生成失败。" Status="XMessageStatus.Error" />
</DemoCard>

<DemoCard Title="自定义列表内容"
          Description="自定义气泡列表内容，这对于个性化定制场景非常有用。"
          SourceCode="@AttachSource">
    <XBubble Header="User" AvatarIcon="user" Placement="XBubblePlacement.End"
             Content="请帮我分析这两个文件。" Attachments="@_atts" Actions="@_actions" />
</DemoCard>

<DemoCard Title="深度思考"
          Description="带深度思考。"
          SourceCode="@ThinkSource">
    <XBubble Header="Assistant" AvatarIcon="robot">
        <ContentTemplate>
            <XThoughtChain Items="@_steps" Compact="true" />
        </ContentTemplate>
    </XBubble>
</DemoCard>

</section>

<section id="api">
    <h2>API</h2>
    <h3>Bubble</h3>
    <XCodeHighlighter Language="csharp" Code="@ApiSource" ShowHeader="false" />
</section>

<section id="contributors">
    <h2>贡献者</h2>
    <p>本演示站使用 AntDesign.Blazor 与 AntDesign.X.Blazor 组件复刻 Ant Design X 文档视觉。</p>
</section>

@code {
    private System.Threading.Timer? _timer;
    private string _typing = string.Empty;
    private const string FullText = "**正在流式生成**：你可以使用 `XSender` + `XBubbleList` 组合实现一个完整的 AI 聊天界面。";

    protected override void OnInitialized() => StartTyping();

    private void StartTyping()
    {
        _typing = string.Empty;
        _timer?.Dispose();
        var i = 0;
        _timer = new System.Threading.Timer(_ =>
        {
            if (i >= FullText.Length) { _timer?.Dispose(); return; }
            _typing += FullText[i++];
            InvokeAsync(StateHasChanged);
        }, null, 200, 50);
    }

    public void Dispose() => _timer?.Dispose();

    private readonly IReadOnlyList<XAttachmentItem> _atts =
    [
        new() { Name = "report.pdf", Size = 204800, ContentType = "application/pdf", Status = XFileCardStatus.Done },
        new() { Name = "chart.png", Size = 80432, ContentType = "image/png", Status = XFileCardStatus.Done },
    ];

    private readonly IReadOnlyList<XActionItem> _actions =
    [
        new() { Key = "copy", Label = "复制", Icon = "copy" },
        new() { Key = "regen", Label = "重答", Icon = "reload" },
    ];

    private readonly IReadOnlyList<XThoughtItem> _steps =
    [
        new() { Title = "理解问题", Status = XSemanticStatus.Success },
        new() { Title = "查询组件库", Status = XSemanticStatus.Success, Content = "命中 XBubbleList / XSender" },
        new() { Title = "组装答案", Status = XSemanticStatus.Success },
    ];

    private IReadOnlyList<XBubbleItem> ListItems { get; } =
    [
        new() { Key = "1", Role = "user", Content = "帮我用 Blazor 写个对话框" },
        new() { Key = "2", Role = "assistant", Content = "可以使用 `XSender` + `XBubbleList` 组合：\n\n```razor\n<XBubbleList Items=\"@msgs\" />\n<XSender @bind-Value=\"@draft\" OnSubmit=\"@send\" />\n```" }
    ];

    private IReadOnlyDictionary<string, XBubbleRoleConfig> RoleConfigs { get; } =
        new Dictionary<string, XBubbleRoleConfig>(StringComparer.OrdinalIgnoreCase)
        {
            ["assistant"] = new() { Placement = XBubblePlacement.Start, AvatarIcon = "robot", Header = "Assistant", Markdown = true },
            ["user"] = new() { Placement = XBubblePlacement.End, AvatarIcon = "user", Header = "You" }
        };

    private const string MarkdownContent = "**Markdown** 支持：\n\n- 列表\n- `code`\n- [链接](https://ant-design-x.antgroup.com/)";

    private const string BasicSource = """
<XBubble Content="Hello!" />
<XBubble Content="你好" Placement="XBubblePlacement.End" />
""";

    private const string AvatarSource = """
<XBubble Content="我是助手" Header="Assistant" AvatarIcon="robot" />
<XBubble Content="我是用户" Header="User" AvatarIcon="user" Placement="XBubblePlacement.End" />
""";

    private const string HeaderFooterSource = """
<XBubble Header="Ant Design X"
         Content="With header and footer."
         AvatarIcon="robot">
    <FooterTemplate>
        <span>Footer content</span>
    </FooterTemplate>
</XBubble>
""";

    private const string VariantSource = """
<XBubble Variant="XBubbleVariant.Filled"     Content="Filled" />
<XBubble Variant="XBubbleVariant.Outlined"   Content="Outlined" />
<XBubble Variant="XBubbleVariant.Borderless" Content="Borderless" />
<XBubble Variant="XBubbleVariant.Shadow"     Content="Shadow" />
""";

    private const string ShapeSource = """
<XBubble Shape="XBubbleShape.Round" Content="Round bubble" />
<XBubble Shape="XBubbleShape.Corner" Content="Corner bubble" />
""";

    private const string LoadingSource = """
<XBubble Loading="true" Header="Assistant" AvatarIcon="robot" />
""";

    private const string TypingSource = """
<XBubble Streaming="true" Markdown="true" Content="@_typing" />
""";

    private const string StatusSource = """
<XBubble Status="XMessageStatus.Loading" Loading="true" />
<XBubble Status="XMessageStatus.Success" Content="完成" />
<XBubble Status="XMessageStatus.Error"   Content="失败" />
<XBubble Status="XMessageStatus.Abort"   Content="中断" />
""";

    private const string AttachSource = """
<XBubble Placement="XBubblePlacement.End"
         Content="请帮我分析" Attachments="@_atts" Actions="@_actions" />
""";

    private const string CustomRenderSource = """
<XBubble Header="Assistant" AvatarIcon="robot">
    <ContentTemplate>
        <p>下面是我推理的过程：</p>
        <XThoughtChain Items="@_steps" />
    </ContentTemplate>
</XBubble>
""";

    private const string ListSource = """
<XBubbleList Items="@ListItems" RoleConfigs="@RoleConfigs" />
""";

    private const string MarkdownSource = """
<XBubble Markdown="true" Content="@MarkdownContent" />
""";

    private const string ThinkSource = """
<XBubble Header="Assistant" AvatarIcon="robot">
    <ContentTemplate>
        <XThoughtChain Items="@_steps" />
    </ContentTemplate>
</XBubble>
""";

    private const string ApiSource = """
Content       string
Header        string
Footer        string
AvatarIcon    string
Placement     XBubblePlacement.Start | XBubblePlacement.End
Variant       Filled | Borderless | Outlined | Shadow
Shape         Round | Corner
Loading       bool
Markdown      bool
""";
}
