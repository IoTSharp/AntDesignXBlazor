@page "/components/sender"
@page "/component/sender"
@layout ComponentLayout
@implements IAsyncDisposable

<PageTitle>Sender 输入框 · AntDesign.X.Blazor</PageTitle>

<h1>Sender 输入框</h1>
<p>对话产品的输入区，支持附件、动作、提交模式、停止/清空、语音、Header/Footer 折叠、编程式聚焦。</p>

<h2 id="when-to-use">何时使用</h2>
<p>用于 AI 对话、Copilot 或智能表单中的消息输入和提交。</p>

<h2 id="examples">代码演示</h2>

<DemoCard Title="基本"
          Description="双向绑定 + Enter 提交。"
          SourceCode="@BasicSource">
    <XSender @bind-Value="_text"
             Placeholder="说点什么..."
             SubmitMode="XSenderSubmitMode.Enter"
             OnSubmit="@OnSubmit"
             OnClear="@(() => _text = string.Empty)" />
    @if (!string.IsNullOrEmpty(_lastSubmit))
    {
        <p class="demo-tip">最近提交：<code>@_lastSubmit</code></p>
    }
</DemoCard>

<DemoCard Title="提交模式"
          Description="Enter / Shift+Enter / Ctrl(⌘)+Enter 三种模式。"
          SourceCode="@SubmitModeSource">
    <div class="demo-grid demo-grid-3">
        <div>
            <h4>Enter 提交</h4>
            <XSender Placeholder="Enter 提交，Shift+Enter 换行" SubmitMode="XSenderSubmitMode.Enter" />
        </div>
        <div>
            <h4>Shift+Enter 提交</h4>
            <XSender Placeholder="Enter 换行，Shift+Enter 提交" SubmitMode="XSenderSubmitMode.ShiftEnter" />
        </div>
        <div>
            <h4>Ctrl/⌘+Enter 提交</h4>
            <XSender Placeholder="Ctrl+Enter 提交" SubmitMode="XSenderSubmitMode.ModEnter" />
        </div>
    </div>
</DemoCard>

<DemoCard Title="附件 + 动作 + Header/Footer"
          Description="附件区、动作槽、可折叠 Header/Footer 模板。"
          SourceCode="@AttachmentSource">
    <XSender @bind-Value="_text2"
             Placeholder="支持附件 / 折叠 Header & Footer..."
             Multiple="true"
             Attachments="@_atts"
             Actions="@_actions"
             HeaderCollapsible="true"
             FooterCollapsible="true"
             OnFilesSelected="@AddFiles"
             OnAttachmentRemove="@RemoveAtt"
             OnAction="@(k => _lastAction = k)"
             OnSubmit="@(r => _lastSubmit = r.Text)">
        <HeaderTemplate>
            <strong>📎 上下文</strong>
            <span class="demo-muted">3 个附件 · 1 个引用</span>
        </HeaderTemplate>
        <FooterTemplate>
            <span class="demo-muted">支持 Markdown · 最多 10 条附件</span>
        </FooterTemplate>
    </XSender>
    @if (!string.IsNullOrEmpty(_lastAction))
    {
        <p class="demo-tip">最近动作：<code>@_lastAction</code></p>
    }
</DemoCard>

<DemoCard Title="Loading + Cancel（停止生成）"
          Description="模拟 LLM 流式响应：发送后进入 loading，按 Stop 中断。"
          SourceCode="@LoadingSource">
    <XSender @bind-Value="_text3"
             Placeholder="发送后将进入 2.5s 模拟生成"
             Loading="_loading"
             OnSubmit="@StartGeneration"
             OnCancel="@CancelGeneration" />
    @if (_streamingOutput is not null)
    {
        <pre class="demo-output">@_streamingOutput</pre>
    }
</DemoCard>

<DemoCard Title="语音输入"
          Description="基于 Web Speech API（需浏览器支持）。"
          SourceCode="@SpeechSource">
    <XSender @bind-Value="_text4"
             AllowSpeech="true"
             SpeechLanguage="zh-CN"
             SpeechInterimResults="true"
             OnSpeechRecording="@(b => _recording = b)"
             OnSpeechErrorEvent="@(e => _speechError = e)" />
    <p class="demo-tip">
        状态：<code>@(_recording ? "录音中" : "未开始")</code>
        @if (!string.IsNullOrEmpty(_speechError))
        {
            <span class="demo-muted">  错误：@_speechError</span>
        }
    </p>
</DemoCard>

<DemoCard Title="编程式 Focus / Blur"
          Description="通过 ref 调用 FocusAsync / BlurAsync。"
          SourceCode="@FocusSource">
    <XSender @ref="_senderRef" Placeholder="点击下方按钮聚焦/失焦" />
    <div class="demo-actions">
        <button class="demo-btn" type="button" @onclick="() => _senderRef!.FocusAsync()">Focus</button>
        <button class="demo-btn" type="button" @onclick="() => _senderRef!.BlurAsync()">Blur</button>
    </div>
</DemoCard>

<DemoCard Title="BeforeUpload 校验"
          Description="拒绝大于 1MB 的文件。"
          SourceCode="@BeforeUploadSource">
    <XSender @bind-Value="_text5"
             Multiple="true"
             Attachments="@_atts2"
             BeforeUpload="@CheckSize"
             OnFilesSelected="@(files => { foreach (var f in files) _atts2.Add(new XAttachmentItem { Name = f.Name, Size = f.Size, Status = XFileCardStatus.Done }); })"
             OnAttachmentRemove="@(id => _atts2.RemoveAll(a => a.Id == id))" />
    @if (!string.IsNullOrEmpty(_uploadMsg))
    {
        <p class="demo-tip">@_uploadMsg</p>
    }
</DemoCard>

<DemoCard Title="只读 / 禁用"
          Description="ReadOnly 仅展示；Disabled 完全禁用。"
          SourceCode="@DisabledSource">
    <div class="demo-grid demo-grid-2">
        <XSender Value="只读内容，无法编辑" ReadOnly="true" />
        <XSender Value="禁用状态" Disabled="true" />
    </div>
</DemoCard>

<h2 id="api">API</h2>
<p><code>XSender</code> 支持 <code>Value</code>、<code>OnSubmit</code>、<code>Loading</code>、<code>Attachments</code>、<code>Actions</code>、<code>HeaderTemplate</code> 和 <code>FooterTemplate</code>。</p>

<h2 id="contributors">贡献者</h2>
<p>Blazor implementation.</p>

@code {
    private string _text = string.Empty;
    private string _text2 = string.Empty;
    private string _text3 = string.Empty;
    private string _text4 = string.Empty;
    private string _text5 = string.Empty;
    private string? _lastSubmit;
    private string? _lastAction;
    private bool _loading;
    private string? _streamingOutput;
    private bool _recording;
    private string? _speechError;
    private string? _uploadMsg;
    private XSender? _senderRef;
    private CancellationTokenSource? _cts;

    private readonly List<XAttachmentItem> _atts =
    [
        new() { Name = "spec.pdf", Size = 102400, ContentType = "application/pdf", Status = XFileCardStatus.Done },
        new() { Name = "design.png", Size = 51200, ContentType = "image/png", Status = XFileCardStatus.Done },
    ];

    private readonly List<XAttachmentItem> _atts2 = [];

    private readonly IReadOnlyList<XActionItem> _actions =
    [
        new() { Key = "search", Label = "搜索", Icon = "search" },
        new() { Key = "image",  Label = "生图",  Icon = "picture" },
        new() { Key = "code",   Label = "代码",  Icon = "code" },
    ];

    private void OnSubmit(XSenderRequest r) { _lastSubmit = r.Text; _text = string.Empty; }

    private void AddFiles(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var f in files)
        {
            _atts.Add(new XAttachmentItem { Name = f.Name, Size = f.Size, ContentType = f.ContentType, Status = XFileCardStatus.Done });
        }
    }
    private void RemoveAtt(string id) => _atts.RemoveAll(a => a.Id == id);

    private async Task StartGeneration(XSenderRequest req)
    {
        _loading = true;
        _streamingOutput = string.Empty;
        _text3 = string.Empty;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        try
        {
            var fake = $"收到「{req.Text}」，正在生成回复 ...";
            foreach (var ch in fake)
            {
                if (_cts.Token.IsCancellationRequested) break;
                _streamingOutput += ch;
                StateHasChanged();
                await Task.Delay(40, _cts.Token);
            }
        }
        catch (TaskCanceledException) { _streamingOutput += "  ⏹ 已中断"; }
        finally { _loading = false; }
    }

    private void CancelGeneration()
    {
        _cts?.Cancel();
        _loading = false;
    }

    private ValueTask<bool> CheckSize(IBrowserFile file)
    {
        if (file.Size > 1024 * 1024)
        {
            _uploadMsg = $"⚠ {file.Name} 超过 1MB，已拦截。";
            return ValueTask.FromResult(false);
        }
        _uploadMsg = $"✔ {file.Name} 已接受。";
        return ValueTask.FromResult(true);
    }

    public ValueTask DisposeAsync() { _cts?.Cancel(); _cts?.Dispose(); return ValueTask.CompletedTask; }

    private const string BasicSource = """
<XSender @bind-Value="_text" SubmitMode="XSenderSubmitMode.Enter" OnSubmit="OnSubmit" />
""";

    private const string SubmitModeSource = """
<XSender SubmitMode="XSenderSubmitMode.Enter" />
<XSender SubmitMode="XSenderSubmitMode.ShiftEnter" />
<XSender SubmitMode="XSenderSubmitMode.ModEnter" />
""";

    private const string AttachmentSource = """
<XSender Multiple="true"
         Attachments="@_atts"
         Actions="@_actions"
         HeaderCollapsible="true"
         FooterCollapsible="true"
         OnFilesSelected="AddFiles"
         OnAttachmentRemove="RemoveAtt">
    <HeaderTemplate><strong>📎 上下文</strong></HeaderTemplate>
    <FooterTemplate><span>支持 Markdown</span></FooterTemplate>
</XSender>
""";

    private const string LoadingSource = """
<XSender @bind-Value="_text"
         Loading="_loading"
         OnSubmit="StartGeneration"
         OnCancel="CancelGeneration" />
""";

    private const string SpeechSource = """
<XSender @bind-Value="_text"
         AllowSpeech="true"
         SpeechLanguage="zh-CN"
         OnSpeechRecording="@(b => _recording = b)" />
""";

    private const string FocusSource = """
<XSender @ref="_senderRef" />
<button @onclick="() => _senderRef!.FocusAsync()">Focus</button>
<button @onclick="() => _senderRef!.BlurAsync()">Blur</button>
""";

    private const string BeforeUploadSource = """
<XSender BeforeUpload="@(file => ValueTask.FromResult(file.Size <= 1024 * 1024))" />
""";

    private const string DisabledSource = """
<XSender Value="只读" ReadOnly="true" />
<XSender Value="禁用" Disabled="true" />
""";
}
