@page "/components/mermaid"
@layout ComponentLayout

<PageTitle>Mermaid 图表 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Mermaid 图表</h1>
    <p>渲染 Mermaid 文本为 SVG，支持源码 / 渲染切换。</p>
</header>

<DemoCard Title="流程图" SourceCode="@FlowSource">
    <XMermaid Title="Flow" Definition="@Flow" AllowRenderTypeToggle="true" />
</DemoCard>

<DemoCard Title="时序图" SourceCode="@SeqSource">
    <XMermaid Title="Sequence" Definition="@Seq" />
</DemoCard>

<DemoCard Title="流式增量"
          Description="逐行追加图表定义，模拟模型流式输出。"
          SourceCode="@StreamSource">
    <XMermaid Title="Streaming" Definition="@_streamDef" />
    <div class="demo-toolbar">
        <button class="demo-button" @onclick="StartStreamAsync" disabled="@_streaming">开始增量</button>
        <button class="demo-button" @onclick="ResetStream">重置</button>
    </div>
</DemoCard>

<DemoCard Title="错误回退"
          Description="非法 Mermaid 语法时显示 OnError 文本与源码回退。"
          SourceCode="@ErrorSource">
    <XMermaid Title="Invalid" Definition="@InvalidMermaid" OnError="@OnMermaidError" />
    @if (!string.IsNullOrEmpty(_lastError))
    {
        <p class="demo-tip">已捕获 OnError：<code>@_lastError</code></p>
    }
</DemoCard>

@code {
    private string _streamDef = InitialStreamDefinition;
    private bool _streaming;
    private string? _lastError;

    private async Task StartStreamAsync()
    {
        _streamDef = InitialStreamDefinition;
        _streaming = true;
        StateHasChanged();
        var lines = new[]
        {
            "    A[User] --> B(Sender)",
            "    B --> C{Has attachments?}",
            "    C -->|Yes| D[Upload]",
            "    C -->|No| E[Submit]",
            "    D --> E",
            "    E --> F[Stream response]",
        };
        foreach (var line in lines)
        {
            _streamDef += line + "\n";
            StateHasChanged();
            await Task.Delay(350);
        }
        _streaming = false;
    }

    private void ResetStream()
    {
        _streamDef = InitialStreamDefinition;
        _streaming = false;
    }

    private void OnMermaidError(string message) => _lastError = message;

    private const string Flow = """
flowchart LR
    A[User] --> B(Sender)
    B --> C{Has attachments?}
    C -->|Yes| D[Upload]
    C -->|No|  E[Submit]
    D --> E
    E --> F[Stream response]
""";

    private const string Seq = """
sequenceDiagram
    participant U as User
    participant S as Sender
    participant M as Model
    U->>S: text + files
    S->>M: chat.completions
    M-->>S: stream chunks
    S-->>U: render bubble
""";

    private const string InvalidMermaid = """
flowchart LR
    A -->>>>> B[broken arrow
""";

    private const string InitialStreamDefinition = """
flowchart LR
    Start[Ready]
""";

    private const string FlowSource = """<XMermaid Title="Flow" Definition="@Flow" AllowRenderTypeToggle="true" />""";
    private const string SeqSource  = """<XMermaid Title="Sequence" Definition="@Seq" />""";
    private const string StreamSource = """<XMermaid Definition="@buffer" />""";
    private const string ErrorSource  = """<XMermaid Definition="@invalid" OnError="OnError" />""";
}
