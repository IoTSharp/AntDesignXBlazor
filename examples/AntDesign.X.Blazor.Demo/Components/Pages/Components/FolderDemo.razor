@page "/components/folder"
@layout ComponentLayout

<PageTitle>Folder 文件夹 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Folder 文件夹</h1>
    <p>展示对话相关的文件树或资源分类。</p>
</header>

<DemoCard Title="基础树"
          Description="Items + Children。"
          SourceCode="@BasicSource">
    <XFolder Items="@_items" Title="知识库" OnSelect="OnSelect" />
    @if (!string.IsNullOrEmpty(_selected))
    {
        <p class="demo-tip">已选中：@_selected</p>
    }
</DemoCard>

<DemoCard Title="无边框"
          Description="Variant=Borderless。"
          SourceCode="@BorderlessSource">
    <XFolder Items="@_items" Variant="XFolderVariant.Borderless" Title="紧凑" />
</DemoCard>

<DemoCard Title="单级 + 禁用"
          Description="Disabled 项。"
          SourceCode="@FlatSource">
    <XFolder Items="@_flat" />
</DemoCard>

@code {
    private string? _selected;

    private readonly IReadOnlyList<XFolderItem> _items =
    [
        new()
        {
            Name = "项目文档",
            Icon = "folder",
            Children =
            [
                new() { Name = "README.md", Icon = "file-text" },
                new() { Name = "ROADMAP.md", Icon = "file-text" },
            ],
        },
        new()
        {
            Name = "源码",
            Icon = "folder",
            Children =
            [
                new() { Name = "Program.cs", Icon = "file" },
                new() { Name = "Layout.razor", Icon = "file" },
            ],
        },
    ];

    private readonly IReadOnlyList<XFolderItem> _flat =
    [
        new() { Name = "可用", Icon = "file" },
        new() { Name = "禁用", Icon = "file", Disabled = true },
    ];

    private void OnSelect(XFolderItem item) => _selected = item.Name;

    private const string BasicSource = """
<XFolder Items="@items" OnSelect="OnSelect" />
""";
    private const string BorderlessSource = """
<XFolder Items="@items" Variant="XFolderVariant.Borderless" />
""";
    private const string FlatSource = """
new XFolderItem { Name = "...", Disabled = true }
""";
}
