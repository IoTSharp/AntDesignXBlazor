@page "/components/folder"
@layout ComponentLayout

<PageTitle>Folder 文件夹 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Folder 文件夹</h1>
    <p>展示对话相关的文件树或资源分类。</p>
</header>

<DemoCard Title="基础树"
          Description="Items + Children。"
          SourceCode="@BasicSource">
    <XFolder Items="@_items" Title="知识库" OnSelect="OnSelect" />
    @if (!string.IsNullOrEmpty(_selected))
    {
        <p class="demo-tip">已选中：@_selected</p>
    }
</DemoCard>

<DemoCard Title="无边框"
          Description="Variant=Borderless。"
          SourceCode="@BorderlessSource">
    <XFolder Items="@_items" Variant="XFolderVariant.Borderless" Title="紧凑" />
</DemoCard>

<DemoCard Title="单级 + 禁用"
          Description="Disabled 项。"
          SourceCode="@FlatSource">
    <XFolder Items="@_flat" />
</DemoCard>

<DemoCard Title="状态徽章"
          Description="XFolderItem.Status / Badge 渲染右侧色带，常用于标记构建/同步状态。"
          SourceCode="@BadgeSource">
    <XFolder Items="@_statusItems" Title="构建状态" />
</DemoCard>

<DemoCard Title="自定义模板"
          Description="ItemTemplate 接管单项渲染。"
          SourceCode="@TemplateSource">
    <XFolder Items="@_items" Title="自定义">
        <ItemTemplate>
            <span class="demo-folder-custom">
                <XIcon Type="@(string.IsNullOrEmpty(context.Icon) ? "folder" : context.Icon)" />
                <strong>@context.Name</strong>
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <em class="demo-folder-desc">— @context.Description</em>
                }
            </span>
        </ItemTemplate>
    </XFolder>
</DemoCard>

@code {
    private string? _selected;

    private readonly IReadOnlyList<XFolderItem> _items =
    [
        new()
        {
            Name = "项目文档",
            Icon = "folder",
            Children =
            [
                new() { Name = "README.md", Icon = "file-text", Description = "入门指南" },
                new() { Name = "ROADMAP.md", Icon = "file-text", Description = "路线图" },
            ],
        },
        new()
        {
            Name = "源码",
            Icon = "folder",
            Children =
            [
                new() { Name = "Program.cs", Icon = "file" },
                new() { Name = "Layout.razor", Icon = "file" },
            ],
        },
    ];

    private readonly IReadOnlyList<XFolderItem> _flat =
    [
        new() { Name = "可用", Icon = "file" },
        new() { Name = "禁用", Icon = "file", Disabled = true },
    ];

    private readonly IReadOnlyList<XFolderItem> _statusItems =
    [
        new() { Name = "build/release", Icon = "deployment-unit", Status = XSemanticStatus.Success },
        new() { Name = "build/staging", Icon = "deployment-unit", Status = XSemanticStatus.Warning, Badge = "queued" },
        new() { Name = "build/preview", Icon = "deployment-unit", Status = XSemanticStatus.Error, Badge = "failed" },
        new() { Name = "build/local",   Icon = "deployment-unit", Status = XSemanticStatus.Processing, Badge = "running" },
        new() { Name = "build/info",    Icon = "deployment-unit", Status = XSemanticStatus.Default, Badge = "info" },
    ];

    private void OnSelect(XFolderItem item) => _selected = item.Name;

    private const string BasicSource = """
<XFolder Items="@items" OnSelect="OnSelect" />
""";
    private const string BorderlessSource = """
<XFolder Items="@items" Variant="XFolderVariant.Borderless" />
""";
    private const string FlatSource = """
new XFolderItem { Name = "...", Disabled = true }
""";
    private const string BadgeSource = """
new XFolderItem { Name = "build/release", Status = XSemanticStatus.Success }
""";
    private const string TemplateSource = """
<XFolder Items="@items">
    <ItemTemplate>
        <strong>@context.Name</strong>
    </ItemTemplate>
</XFolder>
""";
}
