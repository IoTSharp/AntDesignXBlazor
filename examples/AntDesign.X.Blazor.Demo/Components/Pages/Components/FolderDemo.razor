@page "/components/folder"
@layout ComponentLayout

<PageTitle>Folder 文件夹 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Folder 文件夹</h1>
    <p>层级文件夹/分组导航，常用于 RAG 知识库与对话归档。</p>
</header>

<DemoCard Title="基本" SourceCode="@BasicSource">
    <XFolder Title="知识库"
             Items="@Items"
             ActiveKey="@_active"
             ActiveKeyChanged="@(k => _active = k)"
             OnSelect="@(i => _picked = i.Name)" />
    <p class="demo-tip">激活：<code>@_active</code> · 最近：<code>@_picked</code></p>
</DemoCard>

<DemoCard Title="卡片样式" SourceCode="@CardSource">
    <XFolder Title="项目" Items="@Items" Variant="XFolderVariant.Card" />
</DemoCard>

@code {
    private string? _active = "specs";
    private string? _picked;

    private IReadOnlyList<XFolderItem> Items { get; } =
    [
        new() { Key = "specs", Name = "Specs", Icon = "folder", Children =
            [
                new() { Key = "rfc-1", Name = "RFC-001 Architecture" },
                new() { Key = "rfc-2", Name = "RFC-002 Sender" },
            ]},
        new() { Key = "kb",    Name = "Knowledge", Icon = "database" },
        new() { Key = "trash", Name = "Trash",     Icon = "delete", Disabled = true },
    ];

    private const string BasicSource = """
<XFolder Title="知识库" Items="@Items"
         ActiveKey="@_active"
         ActiveKeyChanged="@(k => _active = k)"
         OnSelect="@(i => _picked = i.Name)" />
""";

    private const string CardSource = """
<XFolder Title="项目" Items="@Items" Variant="XFolderVariant.Card" />
""";
}
