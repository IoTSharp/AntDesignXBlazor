@page "/components/actions"
@page "/component/actions"
@layout ComponentLayout

<PageTitle>Actions 操作列表 · AntDesign.X.Blazor</PageTitle>

<h1>Actions 操作列表</h1>
<p>用于快速配置一些 AI 场景下所需要的操作按钮/功能。</p>

<h2 id="when-to-use">何时使用</h2>
<p>Actions 组件用于快速配置一些 AI 场景下所需要的操作按钮/功能。</p>

<h2 id="examples">代码演示</h2>

<DemoCard Title="基本"
          Description="纯图标 + tooltip。"
          SourceCode="@BasicSource">
    <XActions Items="@Items" OnAction="@(k => _last = k)" />
    <p class="demo-tip">最近动作：<code>@_last</code></p>
</DemoCard>

<DemoCard Title="带文字 + 危险态"
          Description="Danger=true 显示红色按钮。"
          SourceCode="@TextSource">
    <XActions Items="@TextItems" OnAction="@(k => _last = k)" />
</DemoCard>

<DemoCard Title="禁用项"
          Description="Disabled=true 不可点击。"
          SourceCode="@DisabledSource">
    <XActions Items="@DisabledItems" />
</DemoCard>

<h2 id="api">API</h2>
<p><code>XActions</code> 通过 <code>Items</code> 描述操作项，并通过 <code>OnAction</code> 返回被点击项的 key。</p>

<h2 id="contributors">贡献者</h2>
<p>Blazor implementation.</p>

@code {
    private string? _last;

    private IReadOnlyList<XActionItem> Items { get; } =
    [
        new() { Key = "copy", Icon = "copy", Tooltip = "复制" },
        new() { Key = "regen", Icon = "reload", Tooltip = "重新生成" },
        new() { Key = "share", Icon = "share-alt", Tooltip = "分享" },
        new() { Key = "more", Icon = "more", Tooltip = "更多" },
    ];

    private IReadOnlyList<XActionItem> TextItems { get; } =
    [
        new() { Key = "save", Icon = "save", Label = "保存" },
        new() { Key = "edit", Icon = "edit", Label = "编辑" },
        new() { Key = "delete", Icon = "delete", Label = "删除", Danger = true },
    ];

    private IReadOnlyList<XActionItem> DisabledItems { get; } =
    [
        new() { Key = "a", Icon = "edit", Label = "可用" },
        new() { Key = "b", Icon = "lock", Label = "已禁用", Disabled = true },
    ];

    private const string BasicSource = """
<XActions Items="@Items" OnAction="@OnAct" />
""";
    private const string TextSource = """
new XActionItem { Label = "删除", Danger = true }
""";
    private const string DisabledSource = """
new XActionItem { Label = "已禁用", Disabled = true }
""";
}
