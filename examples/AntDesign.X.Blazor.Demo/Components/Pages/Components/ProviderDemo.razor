@page "/components/x-provider"
@page "/component/x-provider"
@layout ComponentLayout

<PageTitle>XProvider 全局化配置 · AntDesign.X.Blazor</PageTitle>

<h1>XProvider 全局化配置</h1>
<p>全局主题 token / locale / 默认行为；建议在应用根注入一次。</p>

<h2 id="when-to-use">使用说明</h2>
<p>在应用根部使用 XProvider，为 AntDesign.X.Blazor 组件统一下发主题、暗色模式和局部 token。</p>

<h2 id="examples">代码演示</h2>

<DemoCard Title="使用" SourceCode="@TokensSource">
    <XProvider Tokens="@Tokens">
        <XBubble Header="Assistant" AvatarIcon="robot"
                 Placement="XBubblePlacement.Start"
                 Variant="XBubbleVariant.Filled"
                 Content="主题色与圆角已被覆盖。" />
        <XBubble Header="You" AvatarIcon="user"
                 Placement="XBubblePlacement.End"
                 Variant="XBubbleVariant.Outlined"
                 Content="Tokens 通过 CSS 变量下发。" />
    </XProvider>
</DemoCard>

<DemoCard Title="字号梯度"
          Description="FontSize / FontSizeSm / FontSizeLg / LineHeight 等 token 同步生效。"
          SourceCode="@FontSource">
    <XProvider Tokens="@FontTokens">
        <XBubble Header="Large body" AvatarIcon="font-size"
                 Placement="XBubblePlacement.Start"
                 Content="正文字号 18px / 行高 1.7。" />
    </XProvider>
</DemoCard>

<DemoCard Title="暗色模式 + 嵌套覆盖"
          Description="顶层 IsDark 切换；内部 XProvider 可再次覆盖局部 token。"
          SourceCode="@DarkSource">
    <div class="demo-toolbar">
        <button class="demo-button" @onclick="() => _dark = !_dark">@((_dark ? "切换到浅色" : "切换到暗色"))</button>
    </div>
    <XProvider Theme="@(_dark ? "dark" : "light")" Tokens="@OuterTokens">
        <div class="demo-stack">
            <XBubble Header="Outer assistant" AvatarIcon="robot"
                     Placement="XBubblePlacement.Start"
                     Content="@OuterDescription" />
            <XProvider Tokens="@InnerTokens">
                <XBubble Header="Inner assistant" AvatarIcon="experiment"
                         Placement="XBubblePlacement.Start"
                         Variant="XBubbleVariant.Filled"
                         Content="内层 Provider：覆盖为粉色主题、保留外层暗/亮。" />
            </XProvider>
        </div>
    </XProvider>
</DemoCard>

<h2 id="api">API</h2>
<p><code>XProvider</code> 支持 <code>Theme</code>、<code>Tokens</code> 和局部嵌套覆盖。</p>

<h2 id="contributors">贡献者</h2>
<p>Blazor implementation.</p>

@code {
    private bool _dark;
    private string OuterDescription => $"外层 Provider：{(_dark ? "暗色" : "浅色")} + 蓝色主题。";

    private XThemeTokens Tokens { get; } = new()
    {
        PrimaryColor = "#722ed1",
        BorderRadius = "12px",
        BubbleStartBackground = "#f9f0ff",
        BubbleEndBackground = "#722ed1",
    };

    private XThemeTokens FontTokens { get; } = new()
    {
        FontSize = "18px",
        FontSizeSm = "14px",
        FontSizeLg = "20px",
        FontSizeXl = "26px",
        LineHeight = "1.7",
        LineHeightSm = "1.5",
        LineHeightLg = "1.8",
    };

    private XThemeTokens OuterTokens { get; } = new()
    {
        PrimaryColor = "#1677ff",
        BorderRadius = "10px",
    };

    private XThemeTokens InnerTokens { get; } = new()
    {
        PrimaryColor = "#eb2f96",
        BorderRadius = "20px",
        BubbleStartBackground = "rgba(235, 47, 150, 0.12)",
    };

    private const string TokensSource = """
<XProvider Tokens="@(new XThemeTokens { PrimaryColor = "#722ed1", BorderRadius = "12px" })">
    <XBubble Content="主题色与圆角已被覆盖。" />
</XProvider>
""";

    private const string FontSource = """
<XProvider Tokens="@(new XThemeTokens { FontSize = "18px", LineHeight = "1.7" })">
    <XBubble Content="正文字号 18px / 行高 1.7。" />
</XProvider>
""";

    private const string DarkSource = """
<XProvider Theme="dark" Tokens="@outer">
    <XProvider Tokens="@inner">
        <XBubble Content="嵌套覆盖" />
    </XProvider>
</XProvider>
""";
}
