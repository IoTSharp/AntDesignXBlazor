@page "/components/sources"
@layout ComponentLayout

<PageTitle>Sources 引用源 · AntDesign.X.Blazor</PageTitle>

<header class="demo-page-header">
    <h1>Sources 引用源</h1>
    <p>展示模型回答所引用的外部资源链接。</p>
</header>

<DemoCard Title="基础"
          Description="标题 + 描述 + 链接。"
          SourceCode="@BasicSource">
    <XSources Items="@_items" />
</DemoCard>

<DemoCard Title="紧凑"
          Description="Compact=true 适合在气泡底部展示。"
          SourceCode="@CompactSource">
    <XSources Items="@_items" Compact="true" Title="参考资料" />
</DemoCard>

<DemoCard Title="两列网格"
          Description="Columns=2 启用响应式两列布局；窄屏自动回退为单列。"
          SourceCode="@TwoColSource">
    <XSources Items="@_items" Columns="2" Title="2 列" />
</DemoCard>

<DemoCard Title="三列网格"
          Description="Columns=3 在卡片或宽容器中可读性更好。"
          SourceCode="@ThreeColSource">
    <XSources Items="@_items" Columns="3" Title="3 列" />
</DemoCard>

@code {
    private readonly IReadOnlyList<XSourceItem> _items =
    [
        new()
        {
            Title = "Ant Design X · Welcome",
            Description = "Welcome 组件设计与示例。",
            Url = "https://x.ant.design/components/welcome-cn",
            Icon = "ant-design",
        },
        new()
        {
            Title = "Ant Design X · Bubble",
            Description = "气泡组件文档。",
            Url = "https://x.ant.design/components/bubble-cn",
            Icon = "comment",
        },
        new()
        {
            Title = "AntDesign.X.Blazor 仓库",
            Description = "Blazor 实现的源码与路线图。",
            Url = "https://github.com/",
            Icon = "github",
        },
        new()
        {
            Title = "Microsoft.Extensions.AI",
            Description = ".NET 的统一 AI 抽象。",
            Url = "https://learn.microsoft.com/dotnet/ai/",
            Icon = "cloud",
        },
        new()
        {
            Title = "Blazor Web App",
            Description = "Server + WebAssembly 双模渲染。",
            Url = "https://learn.microsoft.com/aspnet/core/blazor/",
            Icon = "code",
        },
        new()
        {
            Title = "Mermaid",
            Description = "文本驱动的图表渲染。",
            Url = "https://mermaid.js.org/",
            Icon = "node-index",
        },
    ];

    private const string BasicSource = """
<XSources Items="@items" />
""";
    private const string CompactSource = """
<XSources Items="@items" Compact="true" />
""";
    private const string TwoColSource = """
<XSources Items="@items" Columns="2" />
""";
    private const string ThreeColSource = """
<XSources Items="@items" Columns="3" />
""";
}
