@namespace AntDesign.X.Components

<article class="@ClassName" style="@Style">
    @if (AvatarTemplate is not null)
    {
        <div class="antdx-bubble-avatar">@AvatarTemplate</div>
    }
    else if (!string.IsNullOrEmpty(AvatarIcon) || !string.IsNullOrEmpty(AvatarUrl))
    {
        <div class="antdx-bubble-avatar">
            <XIcon Type="@AvatarIcon" Src="@AvatarUrl" Alt="@Header" ImageClass="antdx-bubble-avatar-image" />
        </div>
    }

    <div class="antdx-bubble-body">
        @if (HeaderTemplate is not null)
        {
            <div class="antdx-bubble-header">@HeaderTemplate</div>
        }
        else if (!string.IsNullOrEmpty(Header))
        {
            <div class="antdx-bubble-header">@Header</div>
        }

        <div class="antdx-bubble-content">
            @if (Loading)
            {
                <div class="antdx-bubble-typing" aria-label="Loading">
                    <span></span><span></span><span></span>
                </div>
            }
            else if (ContentTemplate is not null)
            {
                @ContentTemplate
            }
            else if (Markdown && !string.IsNullOrWhiteSpace(Content))
            {
                <XMarkdown Content="@Content" />
            }
            else
            {
                @Content
            }
        </div>

        @if (Attachments.Count > 0)
        {
            <XAttachments Items="@Attachments"
                          Compact="true"
                          Removable="false" />
        }

        @if (FooterTemplate is not null)
        {
            <div class="antdx-bubble-footer">@FooterTemplate</div>
        }
        else if (Actions.Count > 0)
        {
            <XActions Items="@Actions"
                      Size="small"
                      OnAction="@OnAction" />
        }
    </div>
</article>

@code {
    [Parameter] public XBubblePlacement Placement { get; set; } = XBubblePlacement.Start;
    [Parameter] public XBubbleVariant Variant { get; set; }
    [Parameter] public string? AvatarIcon { get; set; }
    [Parameter] public string? AvatarUrl { get; set; }
    [Parameter] public RenderFragment? AvatarTemplate { get; set; }
    [Parameter] public string? Header { get; set; }
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public string? Content { get; set; }
    [Parameter] public RenderFragment? ContentTemplate { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }
    [Parameter] public IReadOnlyList<XAttachmentItem> Attachments { get; set; } = Array.Empty<XAttachmentItem>();
    [Parameter] public IReadOnlyList<XActionItem> Actions { get; set; } = Array.Empty<XActionItem>();
    [Parameter] public EventCallback<string> OnAction { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Markdown { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private string ClassName => XCss.Combine(
        "antdx-bubble",
        $"antdx-bubble-{Placement.ToString().ToLowerInvariant()}",
        $"antdx-bubble-{Variant.ToString().ToLowerInvariant()}",
        Loading ? "antdx-bubble-loading" : null,
        Class);
}
